<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <!-- Virtual Control Templates -->
  <Controls>
    <Backdrop name="LUIE_UF_CompanionAbilitySlot_Template"
              virtual="true"
              mouseEnabled="true"
              centerColor="000000"
              edgeColor="000000"
              hidden="false">
      <Dimensions x="24"
                  y="24" />
      <Edge edgeSize="1" />
      <OnInitialized>
        local center = ZO_ColorDef:New("BF000000")
        local edge = ZO_ColorDef:New("FF000000")
        self:SetCenterColor(center:UnpackRGBA())
        self:SetEdgeColor(edge:UnpackRGBA())
      </OnInitialized>
      <Controls>
        <Texture name="$(parent)_Icon"
                 textureFile=""
                 layer="CONTROLS"
                 hidden="false">
          <Dimensions x="22"
                      y="22" />
          <Anchor point="CENTER"
                  relativeTo="$(parent)"
                  relativePoint="CENTER" />
        </Texture>
        <Cooldown name="$(parent)_Cooldown"
                  inherits="ZO_DefaultCooldown"
                  tier="LOW"
                  hidden="true">
          <AnchorFill />
        </Cooldown>
        <Cooldown name="$(parent)_EffectCooldown"
                  inherits="ZO_DefaultCooldown"
                  tier="LOW"
                  fillColor="33D9D9"
                  alpha="0.2"
                  hidden="true">
          <AnchorFill />
        </Cooldown>
        <Label name="$(parent)_Duration"
               text=""
               font="ZoFontGameSmall"
               color="FFFFFF"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER"
               hidden="true">
          <Anchor point="CENTER"
                  relativeTo="$(parent)"
                  relativePoint="CENTER" />
        </Label>
        <Label name="$(parent)_Stack"
               text=""
               font="ZoFontGameSmall"
               color="FFFFFF"
               horizontalAlignment="RIGHT"
               verticalAlignment="TOP"
               hidden="true">
          <Anchor point="TOPRIGHT"
                  relativeTo="$(parent)"
                  relativePoint="TOPRIGHT"
                  offsetX="-1" />
        </Label>
      </Controls>
    </Backdrop>
    <TopLevelControl name="LUIE_UF_CompanionFrame_Template"
                     virtual="true"
                     mouseEnabled="false"
                     movable="false"
                     clampedToScreen="true"
                     hidden="true"
                     layer="BACKGROUND"
                     level="0"
                     tier="LOW">
      <Dimensions x="150"
                  y="30" />
      <Controls>
        <Control name="$(parent)_Preview"
                 hidden="true"
                 mouseEnabled="false"
                 layer="OVERLAY"
                 tier="LOW"
                 level="100">
          <AnchorFill />
          <Controls>
            <Backdrop name="$(parent)_Backdrop"
                      inherits="LUIE_UF_BlackFill40_WhiteEdge"
                      layer="OVERLAY"
                      tier="LOW"
                      level="100">
              <Edge edgeSize="2" />
              <AnchorFill />
            </Backdrop>
            <Label name="$(parent)_Label"
                   text="Player Companion"
                   font="ZoFontGamepad22"
                   color="FFFFFF"
                   horizontalAlignment="CENTER"
                   verticalAlignment="CENTER">
              <Anchor point="BOTTOM"
                      relativeTo="$(parent)"
                      relativePoint="TOP"
                      offsetY="-1" />
            </Label>
          </Controls>
        </Control>
        <Control name="$(parent)_Companion"
                 hidden="false">
          <Dimensions x="150"
                      y="30" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT" />
          <Controls>
            <Backdrop name="$(parent)_Health"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="false">
              <AnchorFill />
              <Edge edgeSize="1" />
              <Controls>
                <StatusBar name="$(parent)_Bar"
                           hidden="false">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_Trauma"
                           hidden="true">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_Shield"
                           hidden="false">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_NoHealingOverlay"
                           hidden="true">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_NoHealingStripe"
                           hidden="true">
                  <AnchorFill />
                </StatusBar>
                <Control name="$(parent)_PossessionOverlay"
                         hidden="true">
                  <AnchorFill />
                  <Controls>
                    <Texture name="$(parent)_GlowLeft"
                             textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                             layer="OVERLAY"
                             hidden="true">
                      <Dimensions x="10" />
                      <Anchor point="TOPLEFT"
                              relativeTo="$(parent)"
                              relativePoint="TOPLEFT" />
                      <TextureCoords left="0.390625"
                                     right="0.46875"
                                     top="0.359375"
                                     bottom="0.65625" />
                    </Texture>
                    <Texture name="$(parent)_GlowRight"
                             textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                             layer="OVERLAY"
                             hidden="true">
                      <Dimensions x="10" />
                      <Anchor point="TOPRIGHT"
                              relativeTo="$(parent)"
                              relativePoint="TOPRIGHT" />
                      <TextureCoords left="0.46875"
                                     right="0.390625"
                                     top="0.359375"
                                     bottom="0.65625" />
                    </Texture>
                    <Texture name="$(parent)_GlowCenter"
                             textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                             layer="OVERLAY"
                             hidden="true">
                      <Anchor point="TOPLEFT"
                              relativeTo="$(parent)_GlowLeft"
                              relativePoint="TOPRIGHT" />
                      <Anchor point="BOTTOMRIGHT"
                              relativeTo="$(parent)_GlowRight"
                              relativePoint="TOPLEFT" />
                      <TextureCoords left="0.46875"
                                     right="0.5234375"
                                     top="0.359375"
                                     bottom="0.65625" />
                    </Texture>
                  </Controls>
                </Control>
                <Texture name="$(parent)_ArmorInc"
                         textureFile="/esoui/art/icons/alchemy/crafting_alchemy_trait_increasearmor.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Dimensions x="24"
                              y="24" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER"
                          offsetX="13" />
                </Texture>
                <Label name="$(parent)_Label"
                       text="zz%"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="RIGHT"
                       verticalAlignment="CENTER"
                       hidden="false">
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-5" />
                </Label>
                <Label name="$(parent)_Dead"
                       text="Status"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="RIGHT"
                       verticalAlignment="CENTER"
                       hidden="true">
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-5" />
                </Label>
                <Label name="$(parent)_Name"
                       text="Companion"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="LEFT"
                       verticalAlignment="CENTER"
                       hidden="false">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT"
                          offsetX="5" />
                </Label>
              </Controls>
            </Backdrop>
            <Label name="$(parent)_RapportFlourish"
                   text=""
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="LEFT"
                   verticalAlignment="CENTER"
                   layer="OVERLAY"
                   tier="HIGH"
                   hidden="true">
              <Anchor point="LEFT"
                      relativeTo="$(parent)_Health"
                      relativePoint="RIGHT"
                      offsetX="10" />
            </Label>
            <!-- Hotbar slot suffixes 3–8: ACTION_BAR_FIRST_NORMAL_SLOT_INDEX+1 ..
            ACTION_BAR_ULTIMATE_SLOT_INDEX+1 -->
            <Control name="$(parent)_CompanionAbilities"
                     hidden="false">
              <Controls>
                <Backdrop name="$(parent)_SlotBuiltinInterrupt"
                          inherits="LUIE_UF_CompanionAbilitySlot_Template"
                          hidden="true" />
                <Backdrop name="$(parent)_Slot3"
                          inherits="LUIE_UF_CompanionAbilitySlot_Template"
                          hidden="true" />
                <Backdrop name="$(parent)_Slot4"
                          inherits="LUIE_UF_CompanionAbilitySlot_Template"
                          hidden="true" />
                <Backdrop name="$(parent)_Slot5"
                          inherits="LUIE_UF_CompanionAbilitySlot_Template"
                          hidden="true" />
                <Backdrop name="$(parent)_Slot6"
                          inherits="LUIE_UF_CompanionAbilitySlot_Template"
                          hidden="true" />
                <Backdrop name="$(parent)_Slot7"
                          inherits="LUIE_UF_CompanionAbilitySlot_Template"
                          hidden="true" />
                <Backdrop name="$(parent)_Slot8"
                          inherits="LUIE_UF_CompanionAbilitySlot_Template"
                          hidden="true" />
              </Controls>
            </Control>
          </Controls>
        </Control>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>