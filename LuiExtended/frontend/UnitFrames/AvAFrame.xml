<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <!-- Virtual Control Templates -->
  <Controls>
    <TopLevelControl name="LUIE_UF_AvaPlayerTargetFrame_Template"
                     virtual="true"
                     mouseEnabled="false"
                     movable="false"
                     clampedToScreen="true"
                     hidden="true"
                     layer="BACKGROUND"
                     level="0"
                     tier="LOW">
      <Dimensions x="300"
                  y="100" />
      <Controls>
        <Control name="$(parent)_Preview"
                 hidden="true"
                 mouseEnabled="false"
                 layer="OVERLAY"
                 tier="LOW"
                 level="100">
          <AnchorFill />
          <Controls>
            <Backdrop name="$(parent)_Backdrop"
                      inherits="LUIE_UF_BlackFill40_WhiteEdge"
                      layer="OVERLAY"
                      tier="LOW"
                      level="100">
              <Edge edgeSize="2" />
              <AnchorFill />
            </Backdrop>
            <Label name="$(parent)_Label"
                   text="PvP Player Target Frame"
                   font="ZoFontGamepad22"
                   color="FFFFFF"
                   horizontalAlignment="CENTER"
                   verticalAlignment="CENTER">
              <Anchor point="CENTER"
                      relativeTo="$(parent)"
                      relativePoint="CENTER" />
            </Label>
          </Controls>
        </Control>
        <Control name="$(parent)_Target"
                 hidden="false">
          <Dimensions x="300"
                      y="100" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT" />
          <Controls>
            <!-- Health Bar -->
            <Backdrop name="$(parent)_Health"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="false">
              <Dimensions x="300"
                          y="40" />
              <Anchor point="TOP"
                      relativeTo="$(parent)"
                      relativePoint="TOP" />
              <Edge edgeSize="1" />
              <Controls>
                <StatusBar name="$(parent)_Bar"
                           hidden="false">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_Trauma"
                           hidden="true">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_Shield"
                           hidden="false">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_NoHealingOverlay"
                           hidden="true">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_NoHealingStripe"
                           hidden="true">
                  <AnchorFill />
                </StatusBar>
                <Control name="$(parent)_PossessionOverlay"
                         hidden="true">
                  <AnchorFill />
                  <Controls>
                    <Texture name="$(parent)_GlowLeft"
                             textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                             layer="OVERLAY"
                             hidden="true">
                      <Dimensions x="10" />
                      <Anchor point="TOPLEFT"
                              relativeTo="$(parent)"
                              relativePoint="TOPLEFT" />
                      <TextureCoords left="0.390625"
                                     right="0.46875"
                                     top="0.359375"
                                     bottom="0.65625" />
                    </Texture>
                    <Texture name="$(parent)_GlowRight"
                             textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                             layer="OVERLAY"
                             hidden="true">
                      <Dimensions x="10" />
                      <Anchor point="TOPRIGHT"
                              relativeTo="$(parent)"
                              relativePoint="TOPRIGHT" />
                      <TextureCoords left="0.46875"
                                     right="0.390625"
                                     top="0.359375"
                                     bottom="0.65625" />
                    </Texture>
                    <Texture name="$(parent)_GlowCenter"
                             textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                             layer="OVERLAY"
                             hidden="true">
                      <Anchor point="TOPLEFT"
                              relativeTo="$(parent)_GlowLeft"
                              relativePoint="TOPRIGHT" />
                      <Anchor point="BOTTOMRIGHT"
                              relativeTo="$(parent)_GlowRight"
                              relativePoint="TOPLEFT" />
                      <TextureCoords left="0.46875"
                                     right="0.5234375"
                                     top="0.359375"
                                     bottom="0.65625" />
                    </Texture>
                  </Controls>
                </Control>
                <Label name="$(parent)_Label"
                       text="zz%"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="CENTER"
                       verticalAlignment="CENTER"
                       hidden="false">
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Label>
                <Label name="$(parent)_LabelOne"
                       text="xx + ss"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="LEFT"
                       verticalAlignment="CENTER"
                       hidden="false">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT"
                          offsetX="5" />
                </Label>
                <Label name="$(parent)_LabelTwo"
                       text="yy"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="RIGHT"
                       verticalAlignment="CENTER"
                       hidden="false">
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-5" />
                </Label>
              </Controls>
            </Backdrop>
            <!-- Top Info -->
            <Control name="$(parent)_TopInfo"
                     hidden="false">
              <Dimensions x="300"
                          y="20" />
              <Anchor point="BOTTOM"
                      relativeTo="$(parent)_Health"
                      relativePoint="TOP"
                      offsetY="-3" />
              <Controls>
                <Label name="$(parent)_Name"
                       text="Target Name"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="BOTTOM"
                       verticalAlignment="BOTTOM"
                       hidden="false">
                  <Anchor point="BOTTOM"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOM" />
                </Label>
                <Texture name="$(parent)_ClassIcon"
                         textureFile=""
                         layer="OVERLAY"
                         tier="LOW"
                         hidden="false">
                  <Dimensions x="20"
                              y="20" />
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT" />
                </Texture>
                <Texture name="$(parent)_OverlandDifficultyIcon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="18"
                              y="18" />
                  <Anchor point="LEFT"
                          relativeTo="$(parent)_ClassIcon"
                          relativePoint="RIGHT"
                          offsetX="2" />
                </Texture>
                <Texture name="$(parent)_LevelIcon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="20"
                              y="20" />
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT" />
                </Texture>
                <Texture name="$(parent)_VeterancyRankIcon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="20"
                              y="20" />
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT" />
                </Texture>
                <Label name="$(parent)_Level"
                       text="level"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="LEFT"
                       verticalAlignment="TOP"
                       maxLineCount="1"
                       hidden="true">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)_LevelIcon"
                          relativePoint="RIGHT"
                          offsetX="1" />
                </Label>
                <Texture name="$(parent)_AvaRankIcon"
                         textureFile=""
                         hidden="false">
                  <Dimensions x="20"
                              y="20" />
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT" />
                </Texture>
              </Controls>
            </Control>
            <!-- Bottom Info -->
            <Control name="$(parent)_BotInfo"
                     hidden="false">
              <Dimensions x="300"
                          y="20" />
              <Anchor point="TOP"
                      relativeTo="$(parent)_Health"
                      relativePoint="BOTTOM"
                      offsetY="2" />
              <Controls>
                <Label name="$(parent)_ClassName"
                       text="Class"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="TOP"
                       verticalAlignment="TOP"
                       hidden="false">
                  <Anchor point="TOP"
                          relativeTo="$(parent)"
                          relativePoint="TOP" />
                </Label>
                <Label name="$(parent)_Title"
                       text="&lt;Title&gt;"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="TOP"
                       verticalAlignment="BOTTOM"
                       hidden="false">
                  <Anchor point="TOP"
                          relativeTo="$(parent)_ClassName"
                          relativePoint="BOTTOM" />
                </Label>
                <Label name="$(parent)_AvaRank"
                       text="ava"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="TOPRIGHT"
                       verticalAlignment="TOPRIGHT"
                       hidden="false">
                  <Anchor point="TOPRIGHT"
                          relativeTo="$(parent)"
                          relativePoint="TOPRIGHT" />
                </Label>
                <Label name="$(parent)_Dead"
                       text="Status"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="LEFT"
                       verticalAlignment="CENTER"
                       hidden="true">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT"
                          offsetX="5" />
                </Label>
              </Controls>
            </Control>
            <!-- Buff Anchor -->
            <Control name="$(parent)_BuffAnchor"
                     hidden="false">
              <Dimensions x="1"
                          y="1" />
              <Anchor point="TOP"
                      relativeTo="$(parent)_BotInfo"
                      relativePoint="BOTTOM"
                      offsetY="2" />
            </Control>
          </Controls>
        </Control>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>