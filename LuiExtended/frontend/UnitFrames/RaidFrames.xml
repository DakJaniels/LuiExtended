<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <!-- Virtual Control Templates -->
  <Controls>
    <Control virtual="true"
             name="LUIE_UF_RaidGroupMember_Template"
             mouseEnabled="true"
             hidden="false">
      <Dimensions x="150"
                  y="30" />
      <Anchor point="TOPLEFT"
              relativeTo="$(parent)"
              relativePoint="TOPLEFT" />
      <Controls>
        <Backdrop name="$(parent)_Health"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  hidden="false">
          <AnchorFill />
          <Edge edgeSize="1" />
          <Controls>
            <StatusBar name="$(parent)_Bar"
                       hidden="false">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_Trauma"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_Shield"
                       hidden="false">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_NoHealingOverlay"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_NoHealingStripe"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
            <Control name="$(parent)_PossessionOverlay"
                     hidden="true">
              <AnchorFill />
              <Controls>
                <Texture name="$(parent)_GlowLeft"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Dimensions x="10" />
                  <Anchor point="TOPLEFT"
                          relativeTo="$(parent)"
                          relativePoint="TOPLEFT" />
                  <Anchor point="BOTTOMLEFT"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOMLEFT" />
                  <TextureCoords left="0.390625"
                                 right="0.46875"
                                 top="0.359375"
                                 bottom="0.65625" />
                </Texture>
                <Texture name="$(parent)_GlowRight"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Dimensions x="10" />
                  <Anchor point="TOPRIGHT"
                          relativeTo="$(parent)"
                          relativePoint="TOPRIGHT" />
                  <Anchor point="BOTTOMRIGHT"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOMRIGHT" />
                  <TextureCoords left="0.46875"
                                 right="0.390625"
                                 top="0.359375"
                                 bottom="0.65625" />
                </Texture>
                <Texture name="$(parent)_GlowCenter"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Anchor point="TOPLEFT"
                          relativeTo="$(parent)_GlowLeft"
                          relativePoint="TOPRIGHT" />
                  <Anchor point="BOTTOMRIGHT"
                          relativeTo="$(parent)_GlowRight"
                          relativePoint="BOTTOMLEFT" />
                  <TextureCoords left="0.46875"
                                 right="0.5234375"
                                 top="0.359375"
                                 bottom="0.65625" />
                </Texture>
              </Controls>
            </Control>
            <Label name="$(parent)_Label"
                   text="zz%"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="RIGHT"
                   verticalAlignment="CENTER"
                   hidden="false">
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT"
                      offsetX="-5" />
            </Label>
            <Label name="$(parent)_Name"
                   text="Raid1"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="LEFT"
                   verticalAlignment="CENTER"
                   hidden="false">
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT"
                      offsetX="5" />
            </Label>
            <Texture name="$(parent)_RoleIcon"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     hidden="false">
              <Dimensions x="16"
                          y="16" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT"
                      offsetX="4" />
            </Texture>
            <Texture name="$(parent)_ClassIcon"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     hidden="false">
              <Dimensions x="20"
                          y="20" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT"
                      offsetX="1" />
            </Texture>
            <Texture name="$(parent)_CustomIcon"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     inheritAlpha="false"
                     hidden="true">
              <Dimensions x="20"
                          y="20" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)_ClassIcon"
                      relativePoint="RIGHT"
                      offsetX="1" />
            </Texture>
            <Label name="$(parent)_Dead"
                   text="Status"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="RIGHT"
                   verticalAlignment="CENTER"
                   hidden="false">
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT"
                      offsetX="-5" />
            </Label>
            <Texture name="$(parent)_Leader"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     hidden="false">
              <Dimensions x="28"
                          y="28" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT"
                      offsetX="-2" />
            </Texture>
          </Controls>
        </Backdrop>
        <Control name="$(parent)_LibGroupContainer"
                 hidden="false" />
        <Backdrop name="$(parent)_ResourceMagicka"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  hidden="true">
          <Dimensions x="150"
                      y="4" />
          <Anchor point="TOP"
                  relativeTo="$(parent)"
                  relativePoint="BOTTOM" />
          <Edge edgeSize="1" />
          <Controls>
            <StatusBar name="$(parent)_Bar"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
          </Controls>
        </Backdrop>
        <Backdrop name="$(parent)_ResourceStamina"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  hidden="true">
          <Dimensions x="150"
                      y="4" />
          <Anchor point="TOP"
                  relativeTo="$(parent)_ResourceMagicka"
                  relativePoint="BOTTOM" />
          <Edge edgeSize="1" />
          <Controls>
            <StatusBar name="$(parent)_Bar"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
          </Controls>
        </Backdrop>
      </Controls>
    </Control>
    <!--
      Expanded raid member template (selected via UnitFrames.SV.RaidFrameTemplate == "Expanded").
      Mirrors the design: a padded column container with a top row, a health band that grows, and a
    bottom row.
        _Frame     : outer backdrop (the "rhb" column container of the design), padding 2
        _TopRow    : TOPLEFT(2,2) / TOPRIGHT(-2,2), h20   | $(grandparent)_Name | _Leader 20 | _RoleIcon 16 |
    _CustomIcon 20 | _ClassIcon 20
        _Health    : the health band between the rows (2px gap each side); _Bar/_Shield/_Trauma/overlays and
    the
                     health text (_Label / _Dead, right aligned) live here exactly like the compact template
        _BottomRow : BOTTOMLEFT(2,-2) / BOTTOMRIGHT(-2,-2), h16 | _ResourceContainer (2 stacked bars
    filling the row height, sized in Lua) | $(grandparent)_StatsLabel 66x16 + _StatsBorder
        _LibGroupContainer (ult1 / ult2 / potion slots) and _ResourceMagicka / _ResourceStamina are direct
    children.
      Row children use $(grandparent) names so control:GetNamedChild("_Name") etc. resolve (ZOS
    UnitFrames.xml pattern).
      Settings-dependent anchor chains (icons, slot container, resource bars, stats) live in
    UnitFrames.ApplyRaidExpandedMemberLayout.
    -->
    <Control virtual="true"
             name="LUIE_UF_RaidGroupMemberExpanded_Template"
             mouseEnabled="true"
             hidden="false">
      <Dimensions x="200"
                  y="60" />
      <Anchor point="TOPLEFT"
              relativeTo="$(parent)"
              relativePoint="TOPLEFT" />
      <Controls>
        <!-- Outer container backdrop. BACKGROUND layer so the integration
                                slot backdrops
        (DL_BACKGROUND level 13) draw above it. -->
        <Backdrop name="$(parent)_Frame"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  layer="BACKGROUND"
                  hidden="false">
          <AnchorFill />
          <Edge edgeSize="1" />
        </Backdrop>
        <!-- Top row: name (fills) | role icon 16 | class icon 20 | leader
                                20 (chained right-to-left
        in Lua) -->
        <Control name="$(parent)_TopRow"
                 hidden="false">
          <Dimensions y="20" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT"
                  offsetX="2"
                  offsetY="2" />
          <Anchor point="TOPRIGHT"
                  relativeTo="$(parent)"
                  relativePoint="TOPRIGHT"
                  offsetX="-2"
                  offsetY="2" />
          <Controls>
            <Label name="$(grandparent)_Name"
                   text="Raid1"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="LEFT"
                   verticalAlignment="CENTER"
                   hidden="false">
              <Dimensions y="14" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT"
                      offsetX="2" />
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT" />
            </Label>
            <Texture name="$(grandparent)_ClassIcon"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     hidden="false">
              <Dimensions x="20"
                          y="20" />
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT" />
            </Texture>
            <Texture name="$(grandparent)_CustomIcon"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     inheritAlpha="false"
                     hidden="true">
              <Dimensions x="20"
                          y="20" />
              <Anchor point="RIGHT"
                      relativeTo="$(grandparent)_ClassIcon"
                      relativePoint="LEFT"
                      offsetX="-1" />
            </Texture>
            <Texture name="$(grandparent)_RoleIcon"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     hidden="false">
              <Dimensions x="16"
                          y="16" />
              <Anchor point="RIGHT"
                      relativeTo="$(grandparent)_ClassIcon"
                      relativePoint="LEFT"
                      offsetX="-1" />
            </Texture>
            <Texture name="$(grandparent)_Leader"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     hidden="true">
              <Dimensions x="20"
                          y="20" />
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT" />
            </Texture>
          </Controls>
        </Control>
        <!-- Bottom row: slot container (Lua) | resource container h9
                                (stacked bars) | DPS/HPS stats
        66x16 -->
        <Control name="$(parent)_BottomRow"
                 hidden="false">
          <Dimensions y="16" />
          <Anchor point="BOTTOMLEFT"
                  relativeTo="$(parent)"
                  relativePoint="BOTTOMLEFT"
                  offsetX="2"
                  offsetY="-2" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)"
                  relativePoint="BOTTOMRIGHT"
                  offsetX="-2"
                  offsetY="-2" />
          <Controls>
            <Label name="$(grandparent)_StatsLabel"
                   text=""
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="CENTER"
                   verticalAlignment="CENTER"
                   hidden="true">
              <Dimensions x="66"
                          y="16" />
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT" />
            </Label>
            <!-- Stats box behind the DPS / HPS label: same fill
                                                / 1px edge as the slot and resource
            backdrops in this row -->
            <Backdrop name="$(parent)_StatsBorder"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="true">
              <Anchor point="TOPLEFT"
                      relativeTo="$(grandparent)_StatsLabel"
                      relativePoint="TOPLEFT" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(grandparent)_StatsLabel"
                      relativePoint="BOTTOMRIGHT" />
              <Edge edgeSize="1" />
            </Backdrop>
            <!-- Resource container (two stacked 4px bars + 1px
                                                gap): left/right anchors are
            re-chained in Lua (slot container / stats label) -->
            <Control name="$(parent)_ResourceContainer"
                     hidden="false">
              <Dimensions y="9" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT" />
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT" />
            </Control>
          </Controls>
        </Control>
        <!-- Health band: grows between the rows. Same children as the
                                compact _Health so bars /
        shields / overlays wire up unchanged. -->
        <Backdrop name="$(parent)_Health"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  hidden="false">
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)_TopRow"
                  relativePoint="BOTTOMLEFT"
                  offsetY="2" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)_BottomRow"
                  relativePoint="TOPRIGHT"
                  offsetY="-2" />
          <Edge edgeSize="1" />
          <Controls>
            <StatusBar name="$(parent)_Bar"
                       hidden="false">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_Trauma"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_Shield"
                       hidden="false">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_NoHealingOverlay"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_NoHealingStripe"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
            <Control name="$(parent)_PossessionOverlay"
                     hidden="true">
              <AnchorFill />
              <Controls>
                <Texture name="$(parent)_GlowLeft"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Dimensions x="10" />
                  <Anchor point="TOPLEFT"
                          relativeTo="$(parent)"
                          relativePoint="TOPLEFT" />
                  <Anchor point="BOTTOMLEFT"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOMLEFT" />
                  <TextureCoords left="0.390625"
                                 right="0.46875"
                                 top="0.359375"
                                 bottom="0.65625" />
                </Texture>
                <Texture name="$(parent)_GlowRight"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Dimensions x="10" />
                  <Anchor point="TOPRIGHT"
                          relativeTo="$(parent)"
                          relativePoint="TOPRIGHT" />
                  <Anchor point="BOTTOMRIGHT"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOMRIGHT" />
                  <TextureCoords left="0.46875"
                                 right="0.390625"
                                 top="0.359375"
                                 bottom="0.65625" />
                </Texture>
                <Texture name="$(parent)_GlowCenter"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Anchor point="TOPLEFT"
                          relativeTo="$(parent)_GlowLeft"
                          relativePoint="TOPRIGHT" />
                  <Anchor point="BOTTOMRIGHT"
                          relativeTo="$(parent)_GlowRight"
                          relativePoint="BOTTOMLEFT" />
                  <TextureCoords left="0.46875"
                                 right="0.5234375"
                                 top="0.359375"
                                 bottom="0.65625" />
                </Texture>
              </Controls>
            </Control>
            <!-- Health text / status, right aligned on the
                                                health band -->
            <Label name="$(parent)_Label"
                   text="zz%"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="RIGHT"
                   verticalAlignment="CENTER"
                   hidden="false">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="3" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="-3" />
            </Label>
            <Label name="$(parent)_Dead"
                   text="Status"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="RIGHT"
                   verticalAlignment="CENTER"
                   hidden="false">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="3" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="-3" />
            </Label>
          </Controls>
        </Backdrop>
        <!-- LibGroupBroadcast slot container (anchored to the bottom row
                                and sized in Lua). Slots
        mirror SmallGroup.xml at 16px. -->
        <Control name="$(parent)_LibGroupContainer"
                 hidden="false">
          <Dimensions x="54"
                      y="16" />
          <Controls>
            <!-- Food/Drink Buff (SmallGroup.xml slot at the
                                                16px raid size;
            _GroupFoodDrinkBuff.lua) -->
            <Backdrop name="$(parent)_FoodDrinkBackdrop"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="true">
              <Dimensions x="16"
                          y="16" />
              <Edge edgeSize="1" />
              <Controls>
                <Texture name="$(parent)_Icon"
                         textureFile=""
                         hidden="false">
                  <Dimensions x="14"
                              y="14" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Texture>
                <Label name="$(parent)_Label"
                       text=""
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="CENTER"
                       verticalAlignment="BOTTOM"
                       hidden="true">
                  <!-- Inside the 16px slot: a
                                                                        CENTER->BOTTOM anchor would
                                                                        hang the text over the
                  frame edge / combat glow -->
                  <Anchor point="BOTTOM"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOM" />
                </Label>
              </Controls>
            </Backdrop>
            <!-- Ultimate 1 (Frontbar) -->
            <Backdrop name="$(parent)_Ult1Backdrop"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="true">
              <Dimensions x="16"
                          y="16" />
              <Edge edgeSize="1" />
              <Controls>
                <Texture name="$(parent)_Icon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="14"
                              y="14" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Texture>
              </Controls>
            </Backdrop>
            <!-- Ultimate 2 (Backbar) -->
            <Backdrop name="$(parent)_Ult2Backdrop"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="true">
              <Dimensions x="16"
                          y="16" />
              <Edge edgeSize="1" />
              <Controls>
                <Texture name="$(parent)_Icon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="14"
                              y="14" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Texture>
              </Controls>
            </Backdrop>
            <!-- Potion Cooldown -->
            <Backdrop name="$(parent)_PotionBackdrop"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="true">
              <Dimensions x="16"
                          y="16" />
              <Edge edgeSize="1" />
              <Controls>
                <Texture name="$(parent)_Icon"
                         textureFile=""
                         hidden="false">
                  <Dimensions x="14"
                              y="14" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Texture>
                <Label name="$(parent)_Label"
                       text=""
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="CENTER"
                       verticalAlignment="BOTTOM"
                       hidden="true">
                  <Anchor point="BOTTOM"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOM" />
                </Label>
              </Controls>
            </Backdrop>
          </Controls>
        </Control>
        <!-- Half-width resource bars inside _BottomRow_ResourceContainer
                                (anchored in Lua,
        staminaFirst aware) -->
        <Backdrop name="$(parent)_ResourceMagicka"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  hidden="true">
          <Dimensions x="80"
                      y="4" />
          <Edge edgeSize="1" />
          <Controls>
            <StatusBar name="$(parent)_Bar"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
          </Controls>
        </Backdrop>
        <Backdrop name="$(parent)_ResourceStamina"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  hidden="true">
          <Dimensions x="80"
                      y="4" />
          <Edge edgeSize="1" />
          <Controls>
            <StatusBar name="$(parent)_Bar"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
          </Controls>
        </Backdrop>
      </Controls>
    </Control>
    <TopLevelControl name="LUIE_UF_RaidGroupFrame_Template"
                     virtual="true"
                     mouseEnabled="false"
                     movable="false"
                     clampedToScreen="true"
                     hidden="true"
                     layer="BACKGROUND"
                     level="0"
                     tier="LOW">
      <Dimensions x="150"
                  y="30" />
      <Controls>
        <Control name="$(parent)_Preview"
                 hidden="true"
                 mouseEnabled="false"
                 layer="OVERLAY"
                 tier="LOW"
                 level="100">
          <AnchorFill />
          <Controls>
            <Backdrop name="$(parent)_Backdrop"
                      inherits="LUIE_UF_BlackFill40_WhiteEdge"
                      layer="OVERLAY"
                      tier="LOW"
                      level="100">
              <Edge edgeSize="2" />
              <AnchorFill />
            </Backdrop>
            <Label name="$(parent)_Label"
                   text="Raid Group"
                   font="ZoFontGamepad22"
                   color="FFFFFF"
                   horizontalAlignment="CENTER"
                   verticalAlignment="CENTER">
              <Anchor point="BOTTOM"
                      relativeTo="$(parent)"
                      relativePoint="TOP"
                      offsetY="-1" />
            </Label>
          </Controls>
        </Control>
        <!-- Raid Member 1 -->
        <!-- Raid Members 2-12 (similar structure, just positioning) -->
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>