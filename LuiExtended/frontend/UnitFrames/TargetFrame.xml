<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <!-- Virtual Control Templates -->
  <Controls>
    <TopLevelControl name="LUIE_UF_TargetFrame_Template"
                     virtual="true"
                     mouseEnabled="false"
                     movable="false"
                     clampedToScreen="true"
                     hidden="true"
                     layer="BACKGROUND"
                     level="0"
                     tier="LOW">
      <Dimensions x="300"
                  y="120" />
      <Controls>
        <Control name="$(parent)_Preview"
                 hidden="true"
                 mouseEnabled="false"
                 layer="OVERLAY"
                 tier="LOW"
                 level="100">
          <AnchorFill />
          <Controls>
            <Backdrop name="$(parent)_Backdrop"
                      inherits="LUIE_UF_BlackFill40_WhiteEdge"
                      layer="OVERLAY"
                      tier="LOW"
                      level="100">
              <Edge edgeSize="2" />
              <AnchorFill />
            </Backdrop>
            <Label name="$(parent)_Label"
                   text="Target Frame"
                   font="ZoFontGamepad22"
                   color="FFFFFF"
                   horizontalAlignment="CENTER"
                   verticalAlignment="CENTER">
              <Anchor point="CENTER"
                      relativeTo="$(parent)"
                      relativePoint="CENTER" />
            </Label>
          </Controls>
        </Control>
        <Control name="$(parent)_Target"
                 hidden="false">
          <Dimensions x="300"
                      y="120" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT" />
          <Controls>
            <!-- Health Bar -->
            <Backdrop name="$(parent)_Health"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="false">
              <Dimensions x="300"
                          y="40" />
              <Anchor point="TOP"
                      relativeTo="$(parent)"
                      relativePoint="TOP" />
              <Edge edgeSize="1" />
              <Controls>
                <StatusBar name="$(parent)_Bar"
                           hidden="false">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_Trauma"
                           hidden="true">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_Invulnerable"
                           hidden="false">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_InvulnerableInlay"
                           hidden="false">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_Shield"
                           hidden="false">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_NoHealingOverlay"
                           hidden="true">
                  <AnchorFill />
                </StatusBar>
                <StatusBar name="$(parent)_NoHealingStripe"
                           hidden="true">
                  <AnchorFill />
                </StatusBar>
                <Control name="$(parent)_PossessionOverlay"
                         hidden="true">
                  <AnchorFill />
                  <Controls>
                    <Texture name="$(parent)_GlowLeft"
                             textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                             layer="OVERLAY"
                             hidden="true">
                      <Dimensions x="10" />
                      <Anchor point="TOPLEFT"
                              relativeTo="$(parent)"
                              relativePoint="TOPLEFT" />
                      <TextureCoords left="0.390625"
                                     right="0.46875"
                                     top="0.359375"
                                     bottom="0.65625" />
                    </Texture>
                    <Texture name="$(parent)_GlowRight"
                             textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                             layer="OVERLAY"
                             hidden="true">
                      <Dimensions x="10" />
                      <Anchor point="TOPRIGHT"
                              relativeTo="$(parent)"
                              relativePoint="TOPRIGHT" />
                      <TextureCoords left="0.46875"
                                     right="0.390625"
                                     top="0.359375"
                                     bottom="0.65625" />
                    </Texture>
                    <Texture name="$(parent)_GlowCenter"
                             textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                             layer="OVERLAY"
                             hidden="true">
                      <Anchor point="TOPLEFT"
                              relativeTo="$(parent)_GlowLeft"
                              relativePoint="TOPRIGHT" />
                      <Anchor point="BOTTOMRIGHT"
                              relativeTo="$(parent)_GlowRight"
                              relativePoint="TOPLEFT" />
                      <TextureCoords left="0.46875"
                                     right="0.5234375"
                                     top="0.359375"
                                     bottom="0.65625" />
                    </Texture>
                  </Controls>
                </Control>
                <Texture name="$(parent)_ArmorInc"
                         textureFile="/esoui/art/icons/alchemy/crafting_alchemy_trait_increasearmor.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Dimensions x="24"
                              y="24" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER"
                          offsetX="13" />
                </Texture>
                <Label name="$(parent)_LabelOne"
                       text="xx / yy"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="LEFT"
                       verticalAlignment="CENTER"
                       hidden="false">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT"
                          offsetX="5" />
                </Label>
                <Label name="$(parent)_LabelTwo"
                       text="zz%"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="RIGHT"
                       verticalAlignment="CENTER"
                       hidden="false">
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-5" />
                </Label>
                <Label name="$(parent)_Dead"
                       text="Status"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="LEFT"
                       verticalAlignment="CENTER"
                       hidden="true">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT"
                          offsetX="5" />
                </Label>
              </Controls>
            </Backdrop>
            <Texture name="$(parent)_Skull"
                     textureFile="LuiMedia/media/unitframes/unitframes_execute.dds"
                     hidden="true">
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT"
                      offsetX="-8" />
            </Texture>
            <!-- Top Info -->
            <Control name="$(parent)_TopInfo"
                     hidden="false">
              <Dimensions x="300"
                          y="20" />
              <Anchor point="BOTTOM"
                      relativeTo="$(parent)_Health"
                      relativePoint="TOP"
                      offsetY="-3" />
              <Controls>
                <Label name="$(parent)_Name"
                       text="Target Name"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="LEFT"
                       verticalAlignment="BOTTOM"
                       hidden="false">
                  <Anchor point="BOTTOMLEFT"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOMLEFT" />
                </Label>
                <Texture name="$(parent)_OverlandDifficultyIcon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="18"
                              y="18" />
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT" />
                </Texture>
                <Texture name="$(parent)_LevelIcon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="20"
                              y="20" />
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT" />
                </Texture>
                <Texture name="$(parent)_VeterancyRankIcon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="20"
                              y="20" />
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT" />
                </Texture>
                <Label name="$(parent)_Level"
                       text="level"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="LEFT"
                       verticalAlignment="TOP"
                       maxLineCount="1"
                       hidden="false">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)_LevelIcon"
                          relativePoint="RIGHT"
                          offsetX="1" />
                </Label>
                <Texture name="$(parent)_ClassIcon"
                         textureFile=""
                         layer="OVERLAY"
                         tier="LOW"
                         hidden="false">
                  <Dimensions x="22"
                              y="22" />
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-1" />
                </Texture>
                <Label name="$(parent)_ClassName"
                       text="Class"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="BOTTOMRIGHT"
                       verticalAlignment="TOPRIGHT"
                       hidden="false">
                  <Anchor point="BOTTOMRIGHT"
                          relativeTo="$(parent)"
                          relativePoint="TOPRIGHT"
                          offsetX="-1"
                          offsetY="-1" />
                </Label>
                <Texture name="$(parent)_FriendIcon"
                         textureFile=""
                         hidden="false">
                  <Dimensions x="22"
                              y="22" />
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-20" />
                </Texture>
                <Texture name="$(parent)_Star1"
                         textureFile="/esoui/art/ava/ava_bgwindow_capturepointicon.dds"
                         hidden="true">
                  <Dimensions x="16"
                              y="16" />
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-28"
                          offsetY="-1" />
                </Texture>
                <Texture name="$(parent)_Star2"
                         textureFile="/esoui/art/ava/ava_bgwindow_capturepointicon.dds"
                         hidden="true">
                  <Dimensions x="16"
                              y="16" />
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-45"
                          offsetY="-1" />
                </Texture>
                <Texture name="$(parent)_Star3"
                         textureFile="/esoui/art/ava/ava_bgwindow_capturepointicon.dds"
                         hidden="true">
                  <Dimensions x="16"
                              y="16" />
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-62"
                          offsetY="-1" />
                </Texture>
              </Controls>
            </Control>
            <!-- Bottom Info -->
            <Control name="$(parent)_BotInfo"
                     hidden="false">
              <Dimensions x="300"
                          y="20" />
              <Anchor point="TOP"
                      relativeTo="$(parent)_Health"
                      relativePoint="BOTTOM"
                      offsetY="2" />
              <Controls>
                <Label name="$(parent)_Title"
                       text="&lt;Title&gt;"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="TOPLEFT"
                       verticalAlignment="TOPLEFT"
                       hidden="false">
                  <Anchor point="TOPLEFT"
                          relativeTo="$(parent)"
                          relativePoint="TOPLEFT" />
                </Label>
                <Texture name="$(parent)_AvaRankIcon"
                         textureFile=""
                         hidden="false">
                  <Dimensions x="20"
                              y="20" />
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-1" />
                </Texture>
                <Label name="$(parent)_AvaRank"
                       text="ava"
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="RIGHT"
                       verticalAlignment="CENTER"
                       hidden="false">
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)_AvaRankIcon"
                          relativePoint="LEFT"
                          offsetX="-1" />
                </Label>
              </Controls>
            </Control>
            <!-- Buff Anchor -->
            <Control name="$(parent)_BuffAnchor"
                     hidden="false">
              <Dimensions x="1"
                          y="1" />
              <Anchor point="TOP"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOM"
                      offsetY="2" />
            </Control>
          </Controls>
        </Control>
        <!-- Buffs Container (child of TopLevelControl, not Target) -->
        <Control name="$(parent)_Buffs"
                 hidden="false">
          <Anchor point="TOP"
                  relativeTo="$(parent)_Target_BuffAnchor"
                  relativePoint="BOTTOM"
                  offsetY="2" />
          <Controls>
            <Texture name="$(parent)_Preview"
                     textureFile="/esoui/art/miscellaneous/inset_bg.dds"
                     layer="BACKGROUND"
                     hidden="true">
              <AnchorFill />
              <Controls>
                <Label name="$(parent)_Label"
                       wrapMode="ELLIPSIS"
                       horizontalAlignment="CENTER"
                       verticalAlignment="CENTER"
                       excludeFromResizeToFitExtents="true">
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Label>
              </Controls>
            </Texture>
            <Control name="$(parent)_IconHolder"
                     hidden="false">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT" />
            </Control>
          </Controls>
        </Control>
        <!-- Debuffs Container (child of TopLevelControl, not Target) -->
        <Control name="$(parent)_Debuffs"
                 hidden="false">
          <Anchor point="BOTTOM"
                  relativeTo="$(parent)_Target_TopInfo"
                  relativePoint="TOP"
                  offsetY="-2" />
          <Controls>
            <Texture name="$(parent)_Preview"
                     textureFile="/esoui/art/miscellaneous/inset_bg.dds"
                     layer="BACKGROUND"
                     hidden="true">
              <AnchorFill />
              <Controls>
                <Label name="$(parent)_Label"
                       wrapMode="ELLIPSIS"
                       horizontalAlignment="CENTER"
                       verticalAlignment="CENTER"
                       excludeFromResizeToFitExtents="true">
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Label>
              </Controls>
            </Texture>
            <Control name="$(parent)_IconHolder"
                     hidden="false">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT" />
            </Control>
          </Controls>
        </Control>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>