<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <!-- Virtual Control Templates -->
  <Controls>
    <!-- Unit frame virtual templates (instances created in modules/UnitFrames/CustomFrames/) -->
    <Control virtual="true"
             name="LUIE_UF_SmallGroupMember_Template"
             mouseEnabled="true"
             hidden="false">
      <Dimensions x="200"
                  y="50" />
      <Anchor point="TOPLEFT"
              relativeTo="$(parent)"
              relativePoint="TOPLEFT" />
      <Controls>
        <!-- Health Bar -->
        <Backdrop name="$(parent)_Health"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  hidden="false">
          <Dimensions x="200"
                      y="30" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT" />
          <Edge edgeSize="1" />
          <Controls>
            <StatusBar name="$(parent)_Bar"
                       hidden="false">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_Trauma"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_Shield"
                       hidden="false">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_NoHealingOverlay"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
            <StatusBar name="$(parent)_NoHealingStripe"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
            <Control name="$(parent)_PossessionOverlay"
                     hidden="true">
              <AnchorFill />
              <Controls>
                <Texture name="$(parent)_GlowLeft"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Dimensions x="10" />
                  <Anchor point="TOPLEFT"
                          relativeTo="$(parent)"
                          relativePoint="TOPLEFT" />
                  <TextureCoords left="0.390625"
                                 right="0.46875"
                                 top="0.359375"
                                 bottom="0.65625" />
                </Texture>
                <Texture name="$(parent)_GlowRight"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Dimensions x="10" />
                  <Anchor point="TOPRIGHT"
                          relativeTo="$(parent)"
                          relativePoint="TOPRIGHT" />
                  <TextureCoords left="0.46875"
                                 right="0.390625"
                                 top="0.359375"
                                 bottom="0.65625" />
                </Texture>
                <Texture name="$(parent)_GlowCenter"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_possession.dds"
                         layer="OVERLAY"
                         hidden="true">
                  <Anchor point="TOPLEFT"
                          relativeTo="$(parent)_GlowLeft"
                          relativePoint="TOPRIGHT" />
                  <Anchor point="BOTTOMRIGHT"
                          relativeTo="$(parent)_GlowRight"
                          relativePoint="TOPLEFT" />
                  <TextureCoords left="0.46875"
                                 right="0.5234375"
                                 top="0.359375"
                                 bottom="0.65625" />
                </Texture>
              </Controls>
            </Control>
            <Texture name="$(parent)_ArmorInc"
                     textureFile="/esoui/art/icons/alchemy/crafting_alchemy_trait_increasearmor.dds"
                     layer="OVERLAY"
                     hidden="true">
              <Dimensions x="24"
                          y="24" />
              <Anchor point="CENTER"
                      relativeTo="$(parent)"
                      relativePoint="CENTER"
                      offsetX="13" />
            </Texture>
            <Label name="$(parent)_LabelOne"
                   text="xx / yy"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="LEFT"
                   verticalAlignment="CENTER"
                   hidden="false">
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT"
                      offsetX="5" />
            </Label>
            <Label name="$(parent)_LabelTwo"
                   text="zz%"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="RIGHT"
                   verticalAlignment="CENTER"
                   hidden="false">
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT"
                      offsetX="-5" />
            </Label>
            <Texture name="$(parent)_RoleIcon"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     hidden="false">
              <Dimensions x="18"
                          y="18" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT"
                      offsetX="5" />
            </Texture>
            <Label name="$(parent)_Dead"
                   text="Status"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="LEFT"
                   verticalAlignment="CENTER"
                   hidden="false">
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT"
                      offsetX="5" />
            </Label>
            <Label name="$(parent)_StatsLabel"
                   text=""
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="LEFT"
                   verticalAlignment="BOTTOM"
                   hidden="true">
              <Anchor point="TOPRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="-2"
                      offsetY="2" />
            </Label>
          </Controls>
        </Backdrop>
        <!-- Top Info -->
        <Control name="$(parent)_TopInfo"
                 hidden="false">
          <Dimensions x="200"
                      y="20" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)_Health"
                  relativePoint="TOPRIGHT" />
          <Controls>
            <Label name="$(parent)_Name"
                   text="Group1"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="LEFT"
                   verticalAlignment="BOTTOM"
                   hidden="false">
              <Anchor point="BOTTOMLEFT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMLEFT" />
            </Label>
            <Texture name="$(parent)_OverlandDifficultyIcon"
                     textureFile=""
                     hidden="true">
              <Dimensions x="18"
                          y="18" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT" />
            </Texture>
            <Texture name="$(parent)_LevelIcon"
                     textureFile=""
                     hidden="true">
              <Dimensions x="20"
                          y="20" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT" />
            </Texture>
            <Texture name="$(parent)_VeterancyRankIcon"
                     textureFile=""
                     hidden="true">
              <Dimensions x="20"
                          y="20" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="LEFT" />
            </Texture>
            <Label name="$(parent)_Level"
                   text="level"
                   font="ZoFontGameSmall"
                   color="FFFFFF"
                   horizontalAlignment="LEFT"
                   verticalAlignment="TOP"
                   maxLineCount="1"
                   hidden="false">
              <Anchor point="LEFT"
                      relativeTo="$(parent)_LevelIcon"
                      relativePoint="RIGHT"
                      offsetX="1" />
            </Label>
            <Texture name="$(parent)_ClassIcon"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     hidden="false">
              <Dimensions x="22"
                          y="22" />
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT"
                      offsetX="-1" />
            </Texture>
            <Texture name="$(parent)_FriendIcon"
                     textureFile=""
                     hidden="true">
              <Dimensions x="22"
                          y="22" />
              <Anchor point="RIGHT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT"
                      offsetX="-20" />
            </Texture>
            <Texture name="$(parent)_Leader"
                     textureFile=""
                     layer="OVERLAY"
                     tier="LOW"
                     hidden="false">
              <Dimensions x="32"
                          y="32" />
              <Anchor point="BOTTOMLEFT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMLEFT"
                      offsetX="-7" />
            </Texture>
          </Controls>
        </Control>
        <!-- LibGroup Container -->
        <Control name="$(parent)_LibGroupContainer"
                 hidden="false">
          <Controls>
            <!-- Food/Drink Buff -->
            <Backdrop name="$(parent)_FoodDrinkBackdrop"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="true">
              <Dimensions x="24"
                          y="24" />
              <Edge edgeSize="1" />
              <Controls>
                <Texture name="$(parent)_Icon"
                         textureFile=""
                         hidden="false">
                  <Dimensions x="22"
                              y="22" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Texture>
                <Label name="$(parent)_Label"
                       text=""
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="CENTER"
                       verticalAlignment="BOTTOM"
                       hidden="true">
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOM" />
                </Label>
              </Controls>
            </Backdrop>
            <!-- Ultimate 1 (Frontbar) -->
            <Backdrop name="$(parent)_Ult1Backdrop"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="true">
              <Dimensions x="24"
                          y="24" />
              <Edge edgeSize="1" />
              <Controls>
                <Texture name="$(parent)_Icon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="22"
                              y="22" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Texture>
              </Controls>
            </Backdrop>
            <!-- Ultimate 2 (Backbar) -->
            <Backdrop name="$(parent)_Ult2Backdrop"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="true">
              <Dimensions x="24"
                          y="24" />
              <Edge edgeSize="1" />
              <Controls>
                <Texture name="$(parent)_Icon"
                         textureFile=""
                         hidden="true">
                  <Dimensions x="22"
                              y="22" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Texture>
              </Controls>
            </Backdrop>
            <!-- Potion Cooldown -->
            <Backdrop name="$(parent)_PotionBackdrop"
                      inherits="LUIE_UF_BlackFill40_Edge60"
                      hidden="true">
              <Dimensions x="24"
                          y="24" />
              <Edge edgeSize="1" />
              <Controls>
                <Texture name="$(parent)_Icon"
                         textureFile=""
                         hidden="false">
                  <Dimensions x="22"
                              y="22" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </Texture>
                <Label name="$(parent)_Label"
                       text=""
                       font="ZoFontGameSmall"
                       color="FFFFFF"
                       horizontalAlignment="CENTER"
                       verticalAlignment="BOTTOM"
                       hidden="true">
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="BOTTOM" />
                </Label>
              </Controls>
            </Backdrop>
          </Controls>
        </Control>
        <Backdrop name="$(parent)_ResourceMagicka"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  hidden="true">
          <Dimensions x="200"
                      y="6" />
          <Edge edgeSize="1" />
          <Controls>
            <StatusBar name="$(parent)_Bar"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
          </Controls>
        </Backdrop>
        <Backdrop name="$(parent)_ResourceStamina"
                  inherits="LUIE_UF_BlackFill40_Edge60"
                  hidden="true">
          <Dimensions x="200"
                      y="6" />
          <Edge edgeSize="1" />
          <Controls>
            <StatusBar name="$(parent)_Bar"
                       hidden="true">
              <AnchorFill />
            </StatusBar>
          </Controls>
        </Backdrop>
      </Controls>
    </Control>
    <TopLevelControl name="LUIE_UF_SmallGroupFrame_Template"
                     virtual="true"
                     mouseEnabled="false"
                     movable="false"
                     clampedToScreen="true"
                     hidden="true"
                     layer="BACKGROUND"
                     level="0"
                     tier="LOW">
      <Dimensions x="200"
                  y="50" />
      <Controls>
        <Control name="$(parent)_Preview"
                 hidden="true"
                 mouseEnabled="false"
                 layer="OVERLAY"
                 tier="LOW"
                 level="100">
          <AnchorFill />
          <Controls>
            <Backdrop name="$(parent)_Backdrop"
                      inherits="LUIE_UF_BlackFill40_WhiteEdge"
                      layer="OVERLAY"
                      tier="LOW"
                      level="100">
              <Edge edgeSize="2" />
              <AnchorFill />
            </Backdrop>
            <Label name="$(parent)_Label"
                   text="Small Group"
                   font="ZoFontGamepad22"
                   color="FFFFFF"
                   horizontalAlignment="CENTER"
                   verticalAlignment="CENTER">
              <Anchor point="BOTTOM"
                      relativeTo="$(parent)"
                      relativePoint="TOP"
                      offsetY="-1" />
            </Label>
          </Controls>
        </Control>
        <!-- Group Member 1 -->
        <!-- Group Member 2 -->
        <!-- Group Member 3 -->
        <!-- Group Member 4 -->
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>