<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <Controls>
    <!-- Shared preview overlay for combat text panel movers (matches Ability Alerts pattern) -->
    <Backdrop name="LUIE_CombatText_PanelPreviewBacking"
              virtual="true"
              hidden="true"
              centerColor="0D99E6"
              edgeColor="0D99E6">
      <AnchorFill />
      <Edge edgeFileWidth="8"
            edgeFileHeight="1"
            edgeFilePadding="1" />
      <OnInitialized>
        local center = ZO_ColorDef:New("0D99E640")
        local edge = ZO_ColorDef:New("0D99E6E6")
        self:SetCenterColor(center:UnpackRGBA())
        self:SetEdgeColor(edge:UnpackRGBA())
      </OnInitialized>
      <Controls>
        <Texture name="$(parent)_AnchorTexture"
                 textureFile="/esoui/art/reticle/border_topleft.dds"
                 color="FFFF00"
                 alpha="0.902">
          <Dimensions x="16"
                      y="16" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT" />
        </Texture>
        <Backdrop name="$(parent)_AnchorLabelBg"
                  centerColor="000000"
                  edgeColor="000000"
                  layer="OVERLAY"
                  level="0"
                  tier="LOW">
          <Anchor point="BOTTOMLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT"
                  offsetX="0"
                  offsetY="-1" />
          <Edge edgeFileWidth="8"
                edgeFileHeight="1"
                edgeFilePadding="1" />
        </Backdrop>
        <Label name="$(parent)_AnchorLabel"
               font="ZoFontGamepad22"
               color="FFFF00"
               text="0, 0"
               wrapMode="ELLIPSIS"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER"
               layer="OVERLAY"
               level="0"
               tier="MEDIUM">
          <Anchor point="BOTTOMLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT"
                  offsetX="0"
                  offsetY="-1" />
        </Label>
      </Controls>
    </Backdrop>
    <TopLevelControl name="LUIE_CombatText"
                     mouseEnabled="false"
                     clampedToScreen="true"
                     movable="false"
                     layer="BACKGROUND"
                     level="0"
                     tier="LOW">
      <Anchor point="TOPLEFT"
              relativeTo="GuiRoot"
              relativePoint="TOPLEFT"
              offsetX="0"
              offsetY="0" />
      <Anchor point="BOTTOMRIGHT"
              relativeTo="GuiRoot"
              relativePoint="BOTTOMRIGHT"
              offsetX="0"
              offsetY="0" />
      <Controls>
        <Control name="$(parent)_Outgoing"
                 clampedToScreen="true">
          <Anchor point="CENTER"
                  relativeTo="$(parent)"
                  relativePoint="CENTER"
                  offsetX="450"
                  offsetY="-220" />
          <Dimensions x="400"
                      y="100" />
          <DimensionConstraints minX="200"
                                minY="100"
                                maxX="800"
                                maxY="600" />
          <OnMoveStart>
            LUIE.CombatText.OnPanelPreviewMoveStart(self)
          </OnMoveStart>
          <OnMoveStop>
            LUIE.CombatText.OnPanelDragStop(self)
          </OnMoveStop>
          <OnMouseUp>
            LUIE.CombatText.SavePosition(self)
          </OnMouseUp>
          <Controls>
            <Backdrop name="$(parent)_Preview"
                      inherits="LUIE_CombatText_PanelPreviewBacking" />
            <Backdrop name="$(parent)_Backdrop"
                      inherits="ZO_DefaultBackdrop"
                      alpha="0.3"
                      hidden="true" />
            <Label name="$(parent)_Label"
                   font="$(MEDIUM_FONT)|26|soft-shadow-thick"
                   color="FFFFFF"
                   inheritAlpha="true"
                   verticalAlignment="CENTER"
                   horizontalAlignment="CENTER"
                   text=""
                   hidden="true"
                   wrapMode="ELLIPSIS">
              <AnchorFill />
            </Label>
          </Controls>
        </Control>
        <Control name="$(parent)_Incoming"
                 clampedToScreen="true">
          <Anchor point="CENTER"
                  relativeTo="$(parent)"
                  relativePoint="CENTER"
                  offsetX="-450"
                  offsetY="-220" />
          <Dimensions x="400"
                      y="100" />
          <DimensionConstraints minX="200"
                                minY="100"
                                maxX="800"
                                maxY="600" />
          <OnMoveStart>
            LUIE.CombatText.OnPanelPreviewMoveStart(self)
          </OnMoveStart>
          <OnMoveStop>
            LUIE.CombatText.OnPanelDragStop(self)
          </OnMoveStop>
          <OnMouseUp>
            LUIE.CombatText.SavePosition(self)
          </OnMouseUp>
          <Controls>
            <Backdrop name="$(parent)_Preview"
                      inherits="LUIE_CombatText_PanelPreviewBacking" />
            <Backdrop name="$(parent)_Backdrop"
                      inherits="ZO_DefaultBackdrop"
                      alpha="0.3"
                      hidden="true" />
            <Label name="$(parent)_Label"
                   font="$(MEDIUM_FONT)|26|soft-shadow-thick"
                   color="FFFFFF"
                   inheritAlpha="true"
                   verticalAlignment="CENTER"
                   horizontalAlignment="CENTER"
                   text=""
                   hidden="true"
                   wrapMode="ELLIPSIS">
              <AnchorFill />
            </Label>
          </Controls>
        </Control>
        <Control name="$(parent)_Alert"
                 clampedToScreen="true">
          <Anchor point="CENTER"
                  relativeTo="$(parent)"
                  relativePoint="CENTER"
                  offsetX="0"
                  offsetY="250" />
          <Dimensions x="400"
                      y="100" />
          <OnMoveStart>
            LUIE.CombatText.OnPanelPreviewMoveStart(self)
          </OnMoveStart>
          <OnMoveStop>
            LUIE.CombatText.OnPanelDragStop(self)
          </OnMoveStop>
          <OnMouseUp>
            LUIE.CombatText.SavePosition(self)
          </OnMouseUp>
          <Controls>
            <Backdrop name="$(parent)_Preview"
                      inherits="LUIE_CombatText_PanelPreviewBacking" />
            <Backdrop name="$(parent)_Backdrop"
                      inherits="ZO_DefaultBackdrop"
                      alpha="0.3"
                      hidden="true" />
            <Label name="$(parent)_Label"
                   font="$(MEDIUM_FONT)|26|soft-shadow-thick"
                   color="FFFFFF"
                   inheritAlpha="true"
                   verticalAlignment="CENTER"
                   horizontalAlignment="CENTER"
                   text=""
                   hidden="true"
                   wrapMode="ELLIPSIS">
              <AnchorFill />
            </Label>
          </Controls>
        </Control>
        <Control name="$(parent)_Point"
                 clampedToScreen="true">
          <Anchor point="CENTER"
                  relativeTo="$(parent)"
                  relativePoint="CENTER"
                  offsetX="0"
                  offsetY="-300" />
          <Dimensions x="400"
                      y="100" />
          <OnMoveStart>
            LUIE.CombatText.OnPanelPreviewMoveStart(self)
          </OnMoveStart>
          <OnMoveStop>
            LUIE.CombatText.OnPanelDragStop(self)
          </OnMoveStop>
          <OnMouseUp>
            LUIE.CombatText.SavePosition(self)
          </OnMouseUp>
          <Controls>
            <Backdrop name="$(parent)_Preview"
                      inherits="LUIE_CombatText_PanelPreviewBacking" />
            <Backdrop name="$(parent)_Backdrop"
                      inherits="ZO_DefaultBackdrop"
                      alpha="0.3"
                      hidden="true" />
            <Label name="$(parent)_Label"
                   font="$(MEDIUM_FONT)|26|soft-shadow-thick"
                   color="FFFFFF"
                   inheritAlpha="true"
                   verticalAlignment="CENTER"
                   horizontalAlignment="CENTER"
                   text=""
                   hidden="true"
                   wrapMode="ELLIPSIS">
              <AnchorFill />
            </Label>
          </Controls>
        </Control>
        <Control name="$(parent)_Resource"
                 clampedToScreen="true">
          <Anchor point="CENTER"
                  relativeTo="$(parent)"
                  relativePoint="CENTER"
                  offsetX="0"
                  offsetY="375" />
          <Dimensions x="400"
                      y="100" />
          <OnMoveStart>
            LUIE.CombatText.OnPanelPreviewMoveStart(self)
          </OnMoveStart>
          <OnMoveStop>
            LUIE.CombatText.OnPanelDragStop(self)
          </OnMoveStop>
          <OnMouseUp>
            LUIE.CombatText.SavePosition(self)
          </OnMouseUp>
          <Controls>
            <Backdrop name="$(parent)_Preview"
                      inherits="LUIE_CombatText_PanelPreviewBacking" />
            <Backdrop name="$(parent)_Backdrop"
                      inherits="ZO_DefaultBackdrop"
                      alpha="0.3"
                      hidden="true" />
            <Label name="$(parent)_Label"
                   font="$(MEDIUM_FONT)|26|soft-shadow-thick"
                   color="FFFFFF"
                   inheritAlpha="true"
                   verticalAlignment="CENTER"
                   horizontalAlignment="CENTER"
                   text=""
                   hidden="true"
                   wrapMode="ELLIPSIS">
              <AnchorFill />
            </Label>
          </Controls>
        </Control>
      </Controls>
    </TopLevelControl>
    <!-- Virtual / Template -->
    <Control name="LUIE_CombatText_Virtual"
             virtual="true">
      <Controls>
        <Label name="$(parent)_Amount" />
        <Control name="$(parent)_IconHost"
                 hidden="true">
          <Controls>
            <Texture name="$(parent)_IconFrame"
                     inheritAlpha="true"
                     hidden="true" />
            <Texture name="$(parent)_Icon"
                     inheritAlpha="true"
                     hidden="true" />
          </Controls>
        </Control>
        <!--Backdrop
        for debugging purposes-->
        <!--Backdrop
        name="$(parent)_Backdrop" inherits="ZO_DefaultBackdrop" alpha="0.3" hidden="false" /-->
      </Controls>
    </Control>
  </Controls>
</GuiXml>