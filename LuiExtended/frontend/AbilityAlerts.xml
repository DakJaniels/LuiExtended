<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <Controls>
    <TopLevelControl name="LUIE_AlertFrame"
                     mouseEnabled="false"
                     movable="false"
                     clampedToScreen="true"
                     hidden="true"
                     layer="BACKGROUND"
                     level="0"
                     tier="LOW">
      <Dimensions x="500"
                  y="36" />
      <Anchor point="CENTER"
              relativeTo="GuiRoot"
              relativePoint="CENTER"
              offsetX="0"
              offsetY="-250" />
      <OnMoveStart>
				LUIE.CombatInfo.AbilityAlerts.OnMoveStart(self)
			</OnMoveStart>
      <OnMoveStop>
				LUIE.CombatInfo.AbilityAlerts.OnMoveStop(self)
			</OnMoveStop>
      <Controls>
        <!-- Preview background -->
        <Backdrop name="$(parent)_Preview"
                  hidden="true"
                  centerColor="0D99E6"
                  edgeColor="0D99E6">
          <AnchorFill />
          <Edge edgeFileWidth="8"
                edgeFileHeight="1"
                edgeFilePadding="1" />
          <OnInitialized>
            local center = ZO_ColorDef:New("0D99E640")
            local edge = ZO_ColorDef:New("0D99E6E6")
            self:SetCenterColor(center:UnpackRGBA())
            self:SetEdgeColor(edge:UnpackRGBA())
          </OnInitialized>
          <Controls>
            <!-- Anchor texture -->
            <Texture name="$(parent)_AnchorTexture"
                     textureFile="/esoui/art/reticle/border_topleft.dds"
                     color="FFFF00"
                     alpha="0.902">
              <Dimensions x="16"
                          y="16" />
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT" />
            </Texture>
            <!-- Position label background -->
            <Backdrop name="$(parent)_AnchorLabelBg"
                      centerColor="000000"
                      edgeColor="000000"
                      layer="OVERLAY"
                      level="0"
                      tier="LOW">
              <Anchor point="BOTTOMLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="0"
                      offsetY="-1" />
              <Edge edgeFileWidth="8"
                    edgeFileHeight="1"
                    edgeFilePadding="1" />
            </Backdrop>
            <!-- Position label -->
            <Label name="$(parent)_AnchorLabel"
                   font="ZoFontGamepad22"
                   color="FFFF00"
                   text="xxx, yyy"
                   wrapMode="ELLIPSIS"
                   horizontalAlignment="CENTER"
                   verticalAlignment="CENTER"
                   layer="OVERLAY"
                   level="0"
                   tier="MEDIUM">
              <Anchor point="BOTTOMLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="0"
                      offsetY="-1" />
            </Label>
          </Controls>
        </Backdrop>
      </Controls>
    </TopLevelControl>
    <!-- Virtual template for alert controls (used by control pool) -->
    <Control name="LUIE_AlertTemplate"
             virtual="true"
             hidden="true">
      <Dimensions x="300"
                  y="32" />
      <Controls>
        <!-- Prefix label -->
        <Label name="$(parent)_Prefix"
               inheritAlpha="true"
               wrapMode="ELLIPSIS"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="LEFT"
                  relativeTo="$(parent)"
                  relativePoint="LEFT"
                  offsetX="0"
                  offsetY="0" />
        </Label>
        <!-- Name label -->
        <Label name="$(parent)_Name"
               inheritAlpha="true"
               wrapMode="ELLIPSIS"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="LEFT"
                  relativeTo="$(parent)_Prefix"
                  relativePoint="RIGHT"
                  offsetX="0"
                  offsetY="0" />
        </Label>
        <!-- Modifier label -->
        <Label name="$(parent)_Modifier"
               inheritAlpha="true"
               wrapMode="ELLIPSIS"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="LEFT"
                  relativeTo="$(parent)_Name"
                  relativePoint="RIGHT"
                  offsetX="0"
                  offsetY="0" />
        </Label>
        <!-- Icon container -->
        <Backdrop name="$(parent)_Icon"
                  inheritAlpha="true"
                  centerColor="000000"
                  edgeColor="000000">
          <Dimensions x="32"
                      y="32" />
          <Anchor point="LEFT"
                  relativeTo="$(parent)_Modifier"
                  relativePoint="RIGHT"
                  offsetX="6"
                  offsetY="0" />
          <Edge edgeFileWidth="8"
                edgeFileHeight="1"
                edgeFilePadding="1" />
          <OnInitialized>
            local center = ZO_ColorDef:New("00000080")
            local edge = ZO_ColorDef:New("000000FF")
            self:SetCenterColor(center:UnpackRGBA())
            self:SetEdgeColor(edge:UnpackRGBA())
          </OnInitialized>
          <Controls>
            <!-- Icon border -->
            <Texture name="$(parent)_Back"
                     inheritAlpha="true"
                     textureFile="LuiMedia/media/icons/icon_border/icon_border.dds"
                     layer="BACKGROUND">
              <AnchorFill />
            </Texture>
            <!-- Icon background -->
            <Backdrop name="$(parent)_IconBg"
                      inheritAlpha="true"
                      centerColor="000000"
                      edgeColor="000000"
                      alpha="0.902">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="3"
                      offsetY="3" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="-3"
                      offsetY="-3" />
              <Edge edgeFileWidth="8"
                    edgeFileHeight="1"
                    edgeFilePadding="1" />
            </Backdrop>
            <!-- Cooldown control -->
            <Cooldown name="$(parent)_Cd"
                      inheritAlpha="true"
                      fillColor="000000"
                      alpha="0"
                      layer="BACKGROUND">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="1"
                      offsetY="1" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="-1"
                      offsetY="-1" />
            </Cooldown>
            <!-- Icon texture -->
            <Texture name="$(parent)_Icon"
                     inheritAlpha="true"
                     textureFile="/esoui/art/icons/icon_missing.dds"
                     layer="CONTROLS">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="3"
                      offsetY="3" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="-3"
                      offsetY="-3" />
            </Texture>
          </Controls>
        </Backdrop>
        <!-- Mitigation label -->
        <Label name="$(parent)_Mitigation"
               inheritAlpha="true"
               wrapMode="ELLIPSIS"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="LEFT"
                  relativeTo="$(parent)_Icon"
                  relativePoint="RIGHT"
                  offsetX="6"
                  offsetY="0" />
        </Label>
        <!-- Timer label -->
        <Label name="$(parent)_Timer"
               inheritAlpha="true"
               wrapMode="ELLIPSIS"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="LEFT"
                  relativeTo="$(parent)_Mitigation"
                  relativePoint="RIGHT"
                  offsetX="0"
                  offsetY="0" />
        </Label>
      </Controls>
    </Control>
  </Controls>
</GuiXml>