<!--
  LuiExtended
  License: The MIT License (MIT)

  MiniMap chrome overlay. The minimap reuses the real ZO_WorldMap, so this file
  declares only the LUIE chrome that is layered on top of ZO_WorldMap: the frame
  backdrop, the zone label + divider, the zoom percent label, the hover-reveal
  mover (padlock + move grip), and the styled zoom buttons. _Chrome.lua creates
  this template as a child of ZO_WorldMap and positions everything relative to
  ZO_WorldMap / ZO_WorldMapScroll.
-->
<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <Controls>
    <Control name="LUIE_MiniMapChrome"
             virtual="true">
      <AnchorFill />
      <Controls>
        <Backdrop name="$(parent)_Background"
                  inherits="ZO_FrameBackdrop"
                  layer="BACKGROUND">
          <Dimensions x="268"
                      y="268" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT"
                  offsetX="-3"
                  offsetY="-3" />
        </Backdrop>
        <Label name="$(parent)_Zone"
               font="ZoFontGame"
               layer="OVERLAY"
               text="">
          <Anchor point="TOP"
                  relativeTo="$(parent)"
                  relativePoint="BOTTOM"
                  offsetY="4" />
          <Controls>
            <Texture name="$(parent)_Divider"
                     textureFile="EsoUI/Art/Miscellaneous/horizontalDivider.dds">
              <Dimensions y="4" />
              <Anchor point="BOTTOMLEFT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMLEFT"
                      offsetX="-80"
                      offsetY="4" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="80"
                      offsetY="4" />
            </Texture>
          </Controls>
        </Label>
        <Label name="$(parent)_ZoomLabel"
               font="ZoFontGame"
               alpha="0.4"
               layer="OVERLAY"
               tier="HIGH"
               hidden="true"
               text="0%">
          <Anchor point="TOPRIGHT"
                  relativeTo="$(parent)"
                  relativePoint="TOPRIGHT"
                  offsetX="-4"
                  offsetY="4" />
        </Label>
        <Control name="$(parent)_FrameChromeHover"
                 mouseEnabled="true"
                 layer="OVERLAY"
                 tier="HIGH">
          <Dimensions x="24"
                      y="24" />
          <OnMouseEnter>
            LUIE.MiniMap.OnFrameChromeHotspotMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnFrameChromeHotspotMouseExit(self)
          </OnMouseExit>
          <Controls>
            <Control name="$(parent)_FrameChrome"
                     hidden="true"
                     mouseEnabled="true">
              <Dimensions x="44"
                          y="20" />
              <OnMouseEnter>
                LUIE.MiniMap.OnFrameChromeMouseEnter(self)
              </OnMouseEnter>
              <OnMouseExit>
                LUIE.MiniMap.OnFrameChromeMouseExit(self)
              </OnMouseExit>
              <Controls>
                <Button name="$(parent)_PositionLock"
                        inherits="ZO_ButtonBehaviorClickSound"
                        mouseOverBlendMode="ADD"
                        mouseEnabled="true">
                  <Dimensions x="20"
                              y="20" />
                  <OnInitialized>
                    LUIE.MiniMap.OnFramePositionLockInitialized(self)
                  </OnInitialized>
                  <OnClicked>
                    LUIE.MiniMap.OnFramePositionLockClicked(self, button, ctrl, alt, shift, command)
                  </OnClicked>
                </Button>
                <Control name="$(parent)_MoveGrip"
                         inherits="ZO_MouseTooltipBehavior"
                         mouseEnabled="true">
                  <Dimensions x="20"
                              y="20" />
                  <OnInitialized>
                    LUIE.MiniMap.OnFrameMoveGripInitialized(self)
                  </OnInitialized>
                  <OnMouseDown>
                    LUIE.MiniMap.OnFrameMoveGripMouseDown(self, button, ctrl, alt, shift, command)
                  </OnMouseDown>
                  <OnMouseUp>
                    LUIE.MiniMap.OnFrameMoveGripMouseUp(self, button, upInside, ctrl, alt, shift, command)
                  </OnMouseUp>
                  <Controls>
                    <Texture name="$(parent)Icon"
                             resizeToFitFile="true"
                             textureFile="EsoUI/Art/Minimap/minimap_button_over.dds"
                             alpha="0.85">
                      <Anchor point="CENTER" />
                    </Texture>
                  </Controls>
                </Control>
              </Controls>
            </Control>
          </Controls>
        </Control>
        <Control name="$(parent)_ZoomChromeHover"
                 mouseEnabled="true"
                 layer="OVERLAY"
                 tier="HIGH">
          <Dimensions x="32"
                      y="56" />
          <OnMouseEnter>
            LUIE.MiniMap.OnZoomChromeHoverMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnZoomChromeHoverMouseExit(self)
          </OnMouseExit>
        </Control>
        <Button name="$(parent)_ZoomIn"
                inherits="ZO_ButtonBehaviorClickSound"
                hidden="true"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                layer="OVERLAY"
                tier="HIGH">
          <Dimensions x="24"
                      y="24" />
          <Textures normal="EsoUI/Art/Minimap/minimap_zoomplus_up.dds"
                    pressed="EsoUI/Art/Minimap/minimap_zoomplus_down.dds"
                    disabled="EsoUI/Art/Minimap/minimap_zoomplus_disabled.dds"
                    mouseOver="EsoUI/Art/Minimap/minimap_zoom_mouseover.dds" />
          <OnClicked>
            LUIE.MiniMap.OnZoomInClicked(self, button, ctrl, alt, shift, command)
          </OnClicked>
          <OnMouseEnter>
            LUIE.MiniMap.OnZoomChromeHoverMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnZoomChromeHoverMouseExit(self)
          </OnMouseExit>
        </Button>
        <Button name="$(parent)_ZoomOut"
                inherits="ZO_ButtonBehaviorClickSound"
                hidden="true"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                layer="OVERLAY"
                tier="HIGH">
          <Dimensions x="24"
                      y="24" />
          <Textures normal="EsoUI/Art/Minimap/minimap_zoomminus_up.dds"
                    pressed="EsoUI/Art/Minimap/minimap_zoomminus_down.dds"
                    disabled="EsoUI/Art/Minimap/minimap_zoomminus_disabled.dds"
                    mouseOver="EsoUI/Art/Minimap/minimap_zoom_mouseover.dds" />
          <OnClicked>
            LUIE.MiniMap.OnZoomOutClicked(self, button, ctrl, alt, shift, command)
          </OnClicked>
          <OnMouseEnter>
            LUIE.MiniMap.OnZoomChromeHoverMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnZoomChromeHoverMouseExit(self)
          </OnMouseExit>
        </Button>
      </Controls>
    </Control>
  </Controls>
</GuiXml>
