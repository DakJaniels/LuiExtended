<?xml version="1.0" encoding="UTF-8"?>
<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <Controls>
    <!-- Pool templates (MiniMap_TileLayer.lua / MiniMap_PinLayer.lua). Copies of the ZOS virtuals in
         EsoUI/Ingame/Map/WorldMap.xml (ZO_MapTile, ZO_PinBlob, ZO_PinPolygonBlob, ZO_MapKeepLink) and
         EsoUI/Ingame/Map/MapPin.xml (ZO_MapPin) without mouse handlers. -->
    <Texture name="LUIE_MiniMap_Tile"
             pixelRoundingEnabled="false"
             textureFileReleaseOption="RELEASE_TEXTURE_AT_ZERO_REFERENCES"
             virtual="true">
      <Dimensions x="230"
                  y="230" />
    </Texture>
    <Control name="LUIE_MiniMap_Pin"
             tier="HIGH"
             level="10"
             hidden="true"
             virtual="true">
      <Dimensions x="22"
                  y="22" />
      <Controls>
        <Texture name="$(parent)Highlight"
                 textureFile="EsoUI/Art/MapPins/UI-WorldMapPinHighlight.dds"
                 pixelRoundingEnabled="false"
                 hidden="true">
          <Anchor point="TOPLEFT"
                  offsetX="-5"
                  offsetY="-5" />
          <Anchor point="BOTTOMRIGHT"
                  offsetX="5"
                  offsetY="5" />
        </Texture>
        <Texture name="$(parent)Background"
                 pixelRoundingEnabled="false">
          <AnchorFill />
        </Texture>
      </Controls>
    </Control>
    <Texture name="LUIE_MiniMap_AreaBlob"
             tier="HIGH"
             level="6"
             pixelRoundingEnabled="false"
             shaderEffectType="HALO"
             virtual="true" />
    <Polygon name="LUIE_MiniMap_PolygonBlob"
             pointLayout="COUNTER_CLOCKWISE"
             smoothingEnabled="true"
             layer="BACKGROUND"
             tier="HIGH"
             level="6"
             virtual="true">
      <Border minThickness="3px"
              maxThickness="3px"
              textureFile="EsoUI/Art/MapPins/PolygonPinBorder.dds" />
    </Polygon>
    <Line name="LUIE_MiniMap_KeepLink"
          level="1"
          thickness="8"
          virtual="true" />

    <TopLevelControl name="LUIE_MiniMap"
                     mouseEnabled="true"
                     movable="true"
                     resizeHandleSize="8"
                     clampedToScreen="true"
                     hidden="true"
                     shape="BOX"
                     tier="MEDIUM"
                     allowBringToTop="true"
                     space="SPACE_INTERFACE">
      <Dimensions x="260"
                  y="260" />
      <Anchor point="BOTTOMRIGHT"
              relativeTo="GuiRoot"
              relativePoint="BOTTOMRIGHT"
              offsetX="-50"
              offsetY="-50" />
      <OnMoveStop>
        LUIE.MiniMap.OnRootMoveStop(self)
      </OnMoveStop>
      <OnResizeStart>
        LUIE.MiniMap.OnRootResizeStart(self)
      </OnResizeStart>
      <OnResizeStop>
        LUIE.MiniMap.OnRootResizeStop(self)
      </OnResizeStop>
      <OnMouseWheel>
        LUIE.MiniMap.OnRootMouseWheel(self, delta, ctrl, alt, shift, command)
      </OnMouseWheel>
      <OnRectChanged>
        LUIE.MiniMap.OnRootRectChanged(self, newLeft, newTop, newRight, newBottom, oldLeft, oldTop, oldRight, oldBottom)
      </OnRectChanged>
      <Controls>
        <Label name="$(parent)_Zone"
               font="ZoFontGame"
               layer="1"
               text="">
          <Anchor point="TOP"
                  relativeTo="$(parent)"
                  relativePoint="BOTTOM"
                  offsetY="4" />
          <Controls>
            <Texture name="$(parent)_Divider"
                     textureFile="EsoUI/Art/Miscellaneous/horizontalDivider.dds">
              <Dimensions y="4" />
              <Anchor point="BOTTOMLEFT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMLEFT"
                      offsetX="-80"
                      offsetY="4" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="80"
                      offsetY="4" />
            </Texture>
          </Controls>
        </Label>
        <Backdrop name="$(parent)_Background"
                  inherits="ZO_FrameBackdrop"
                  resizeToFitDescendents="true"
                  layer="BACKGROUND">
          <Dimensions x="268"
                      y="268" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT"
                  offsetX="-3"
                  offsetY="-3" />
        </Backdrop>
        <!-- Parchment matte between the ZO_FrameBackdrop edge and the map sheet (ZO_WorldMapContainerBackground
             texture, WorldMap.xml:265). Declared after _Background so the anchor resolves; inset by the 4px
             edge of ZO_FrameBackdrop (WindowTemplates.xml:96). Texture coords are set by MiniMap_Frame. -->
        <Texture name="$(parent)_Parchment"
                 textureFile="EsoUI/Art/WorldMap/worldmap_map_background_512tile.dds"
                 addressMode="WRAP"
                 autoAdjustTextureCoords="false"
                 layer="BACKGROUND"
                 level="1">
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)_Background"
                  relativePoint="TOPLEFT"
                  offsetX="4"
                  offsetY="4" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)_Background"
                  relativePoint="BOTTOMRIGHT"
                  offsetX="-4"
                  offsetY="-4" />
        </Texture>
        <Scroll name="$(parent)_Scroll"
                mouseEnabled="true">
          <Dimensions x="260"
                      y="260" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT" />
          <OnMouseDown>
            LUIE.MiniMap.OnScrollMouseDown(self, button, ctrl, alt, shift, command)
          </OnMouseDown>
          <OnMouseUp>
            LUIE.MiniMap.OnScrollMouseUp(self, button, upInside, ctrl, alt, shift, command)
          </OnMouseUp>
          <OnScrollOffsetChanged>
            LUIE.MiniMap.OnScrollOffsetChanged(self, horizontal, vertical)
          </OnScrollOffsetChanged>
          <Controls>
            <!-- Map sheet: sized to zoom * tile pixel size by MiniMap_PanAndZoom. Layers draw tiles, keep links,
                 area/polygon blobs, then pins (tier/level come from the pool templates). -->
            <Control name="$(parent)_Map"
                     mouseEnabled="true"
                     hidden="false"
                     layer="3">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT" />
              <OnMouseDown>
                LUIE.MiniMap.OnMapMouseDown(self, button, ctrl, alt, shift, command)
              </OnMouseDown>
              <OnMouseUp>
                LUIE.MiniMap.OnMapMouseUp(self, button, upInside, ctrl, alt, shift, command)
              </OnMouseUp>
              <Controls>
                <Control name="$(parent)_Tiles">
                  <AnchorFill />
                </Control>
                <Control name="$(parent)_Links">
                  <AnchorFill />
                </Control>
                <Control name="$(parent)_Polygons">
                  <AnchorFill />
                </Control>
                <Control name="$(parent)_Pins">
                  <AnchorFill />
                </Control>
              </Controls>
            </Control>
            <StatusBar name="$(parent)_StatusOverlay"
                       layer="2"
                       tier="HIGH"
                       level="250"
                       color="ffffff"
                       alpha="0.8"
                       hidden="false">
              <AnchorFill />
              <Controls>
                <Label name="$(parent)_Label"
                       font="ZoFontAnnounceMedium"
                       layer="2"
                       tier="HIGH"
                       level="251"
                       text="">
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER"
                          offsetY="0" />
                </Label>
              </Controls>
            </StatusBar>
          </Controls>
        </Scroll>
        <Label name="$(parent)_ZoomLabel"
               font="ZoFontGame"
               alpha="0.4"
               layer="4"
               tier="HIGH"
               hidden="true"
               text="0%">
          <Anchor point="TOPRIGHT"
                  relativeTo="$(parent)_Scroll"
                  relativePoint="TOPRIGHT"
                  offsetX="-4"
                  offsetY="4" />
        </Label>
        <!-- Drag bar: the bar itself is the mouse-over region and the drag handle; the padlock is its only
             mouse-enabled child. Mouse exit is checked with MouseIsOver on an update (EsoUI/Ingame/Contextual/Contextual.lua:137),
             so crossing onto the padlock never counts as leaving. Size and anchors are applied from Lua. -->
        <Control name="$(parent)_DragBar"
                 mouseEnabled="true"
                 layer="4"
                 tier="HIGH">
          <Dimensions x="64"
                      y="36" />
          <OnInitialized>
            LUIE.MiniMap.OnDragBarInitialized(self)
          </OnInitialized>
          <OnMouseEnter>
            LUIE.MiniMap.OnDragBarMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnDragBarMouseExit(self)
          </OnMouseExit>
          <OnDragStart>
            LUIE.MiniMap.OnDragBarDragStart(self, button)
          </OnDragStart>
          <OnMouseUp>
            LUIE.MiniMap.OnDragBarMouseUp(self, button, upInside, ctrl, alt, shift, command)
          </OnMouseUp>
          <Controls>
            <!-- ZO_DarkThinFrame textures (EsoUI/Libraries/ZO_Templates/WindowTemplates.xml:142-147), inset by the hit padding. -->
            <Backdrop name="$(parent)_Backdrop"
                      layer="4"
                      tier="HIGH"
                      alpha="0.9">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="4"
                      offsetY="4" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="-4"
                      offsetY="-4" />
              <Edge file="EsoUI/Art/Miscellaneous/dark_edgeFrame_8_thin.dds"
                    edgeFileWidth="64"
                    edgeFileHeight="8" />
              <Center file="EsoUI/Art/Miscellaneous/Gamepad/gp_edgeFill.dds" />
            </Backdrop>
            <Button name="$(parent)_PositionLock"
                    inherits="ZO_ButtonBehaviorClickSound"
                    mouseOverBlendMode="ADD"
                    mouseEnabled="true"
                    layer="4"
                    tier="HIGH"
                    level="1">
              <Dimensions x="24"
                          y="24" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)_Backdrop"
                      relativePoint="LEFT"
                      offsetX="4"
                      offsetY="0" />
              <OnInitialized>
                LUIE.MiniMap.OnPositionLockInitialized(self)
              </OnInitialized>
              <OnClicked>
                LUIE.MiniMap.OnPositionLockClicked(self, button, ctrl, alt, shift, command)
              </OnClicked>
              <OnMouseEnter>
                LUIE.MiniMap.OnPositionLockMouseEnter(self)
              </OnMouseEnter>
              <OnMouseExit>
                LUIE.MiniMap.OnPositionLockMouseExit(self)
              </OnMouseExit>
            </Button>
            <!-- Decorative drag handle (three solid-colour lines); not mouse enabled so the bar receives the drag. -->
            <Control name="$(parent)_DragHandle"
                     layer="4"
                     tier="HIGH"
                     level="1">
              <Dimensions x="20"
                          y="24" />
              <Anchor point="LEFT"
                      relativeTo="$(parent)_PositionLock"
                      relativePoint="RIGHT"
                      offsetX="0"
                      offsetY="0" />
              <Controls>
                <Texture name="$(parent)_Line1"
                         color="C6C39C"
                         alpha="0.8">
                  <Dimensions x="12"
                              y="2" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER"
                          offsetX="0"
                          offsetY="-5" />
                </Texture>
                <Texture name="$(parent)_Line2"
                         color="C6C39C"
                         alpha="0.8">
                  <Dimensions x="12"
                              y="2" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER"
                          offsetX="0"
                          offsetY="0" />
                </Texture>
                <Texture name="$(parent)_Line3"
                         color="C6C39C"
                         alpha="0.8">
                  <Dimensions x="12"
                              y="2" />
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER"
                          offsetX="0"
                          offsetY="5" />
                </Texture>
              </Controls>
            </Control>
          </Controls>
        </Control>
        <Texture name="$(parent)_Player"
                 resizeToFitFile="true"
                 layer="2"
                 textureFile="EsoUI/Art/MapPins/UI-WorldMapPlayerPip.dds">
          <Anchor point="CENTER"
                  relativeTo="$(parent)_Scroll"
                  relativePoint="CENTER" />
        </Texture>
        <Texture name="$(parent)_PlayerCam"
                 resizeToFitFile="true"
                 layer="1"
                 textureFile="EsoUI/Art/MapPins/UI-WorldMapPlayerCameraPip.dds"
                 alpha="1">
          <Anchor point="CENTER"
                  relativeTo="$(parent)_Scroll"
                  relativePoint="CENTER" />
        </Texture>
        <Control name="$(parent)_ZoomMouseOverArea"
                 mouseEnabled="true"
                 layer="2"
                 tier="HIGH">
          <Dimensions x="32"
                      y="56" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)_Scroll"
                  relativePoint="BOTTOMRIGHT"
                  offsetX="-54"
                  offsetY="0" />
          <OnMouseEnter>
            LUIE.MiniMap.OnZoomMouseOverAreaMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnZoomMouseOverAreaMouseExit(self)
          </OnMouseExit>
        </Control>
        <Button name="$(parent)_ZoomIn"
                inherits="ZO_ButtonBehaviorClickSound"
                hidden="true"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                layer="4"
                tier="HIGH">
          <Dimensions x="24"
                      y="24" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)_Scroll"
                  relativePoint="BOTTOMRIGHT"
                  offsetX="-4"
                  offsetY="-4" />
          <Textures normal="EsoUI/Art/Minimap/minimap_zoomplus_up.dds"
                    pressed="EsoUI/Art/Minimap/minimap_zoomplus_down.dds"
                    disabled="EsoUI/Art/Minimap/minimap_zoomplus_disabled.dds"
                    mouseOver="EsoUI/Art/Minimap/minimap_zoom_mouseover.dds" />
          <OnClicked>
            LUIE.MiniMap.OnZoomInClicked(self, button, ctrl, alt, shift, command)
          </OnClicked>
          <OnMouseEnter>
            LUIE.MiniMap.OnZoomMouseOverAreaMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnZoomMouseOverAreaMouseExit(self)
          </OnMouseExit>
        </Button>
        <Button name="$(parent)_ZoomOut"
                inherits="ZO_ButtonBehaviorClickSound"
                hidden="true"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                layer="4"
                tier="HIGH">
          <Dimensions x="24"
                      y="24" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)_ZoomIn"
                  relativePoint="BOTTOMLEFT"
                  offsetX="-2"
                  offsetY="0" />
          <Textures normal="EsoUI/Art/Minimap/minimap_zoomminus_up.dds"
                    pressed="EsoUI/Art/Minimap/minimap_zoomminus_down.dds"
                    disabled="EsoUI/Art/Minimap/minimap_zoomminus_disabled.dds"
                    mouseOver="EsoUI/Art/Minimap/minimap_zoom_mouseover.dds" />
          <OnClicked>
            LUIE.MiniMap.OnZoomOutClicked(self, button, ctrl, alt, shift, command)
          </OnClicked>
          <OnMouseEnter>
            LUIE.MiniMap.OnZoomMouseOverAreaMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnZoomMouseOverAreaMouseExit(self)
          </OnMouseExit>
        </Button>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
