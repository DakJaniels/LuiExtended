<?xml version="1.0" encoding="UTF-8"?>
<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <Controls>
    <TopLevelControl name="LUIE_MiniMap"
                     mouseEnabled="true"
                     movable="true"
                     resizeHandleSize="8"
                     clampedToScreen="true"
                     hidden="true"
                     shape="BOX"
                     tier="MEDIUM"
                     allowBringToTop="true"
                     space="SPACE_INTERFACE">
      <Dimensions x="260"
                  y="260" />
      <Anchor point="BOTTOMRIGHT"
              relativeTo="GuiRoot"
              relativePoint="BOTTOMRIGHT"
              offsetX="-50"
              offsetY="-50" />
      <OnMoveStop>
        LUIE.MiniMap.OnRootMoveStop(self)
      </OnMoveStop>
      <OnResizeStart>
        LUIE.MiniMap.OnRootResizeStart(self)
      </OnResizeStart>
      <OnResizeStop>
        LUIE.MiniMap.OnRootResizeStop(self)
      </OnResizeStop>
      <OnMouseWheel>
        LUIE.MiniMap.OnRootMouseWheel(self, delta, ctrl, alt, shift, command)
      </OnMouseWheel>
      <OnUpdate>
        LUIE.MiniMap.OnRootUpdate(self, time)
      </OnUpdate>
      <OnRectChanged>
        LUIE.MiniMap.OnRootRectChanged(self, newLeft, newTop, newRight, newBottom, oldLeft, oldTop, oldRight, oldBottom)
      </OnRectChanged>
      <Controls>
        <Label name="$(parent)_Zone"
               font="ZoFontGame"
               layer="1"
               text="">
          <Anchor point="TOP"
                  relativeTo="$(parent)"
                  relativePoint="BOTTOM"
                  offsetY="4" />
          <Controls>
            <Texture name="$(parent)_Divider"
                     textureFile="EsoUI/Art/Miscellaneous/horizontalDivider.dds">
              <Dimensions y="4" />
              <Anchor point="BOTTOMLEFT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMLEFT"
                      offsetX="-80"
                      offsetY="4" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="80"
                      offsetY="4" />
            </Texture>
          </Controls>
        </Label>
        <Backdrop name="$(parent)_Background"
                  inherits="ZO_FrameBackdrop"
                  resizeToFitDescendents="true"
                  layer="BACKGROUND">
          <Dimensions x="268"
                      y="268" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT"
                  offsetX="-3"
                  offsetY="-3" />
        </Backdrop>
        <Scroll name="$(parent)_Scroll"
                mouseEnabled="true">
          <Dimensions x="260"
                      y="260" />
          <Anchor point="TOPLEFT"
                  relativeTo="$(parent)"
                  relativePoint="TOPLEFT" />
          <OnMouseDown>
            LUIE.MiniMap.OnScrollMouseDown(self, button, ctrl, alt, shift, command)
          </OnMouseDown>
          <OnMouseUp>
            LUIE.MiniMap.OnScrollMouseUp(self, button, upInside, ctrl, alt, shift, command)
          </OnMouseUp>
          <OnScrollOffsetChanged>
            LUIE.MiniMap.OnScrollOffsetChanged(self, horizontal, vertical)
          </OnScrollOffsetChanged>
          <Controls>
            <Control name="$(parent)_Map"
                     mouseEnabled="true"
                     hidden="false"
                     layer="3">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT" />
              <OnMouseDown>
                LUIE.MiniMap.OnMapMouseDown(self, button, ctrl, alt, shift, command)
              </OnMouseDown>
              <OnMouseUp>
                LUIE.MiniMap.OnMapMouseUp(self, button, upInside, ctrl, alt, shift, command)
              </OnMouseUp>
              <OnUpdate>
                LUIE.MiniMap.OnMapUpdate(self, time)
              </OnUpdate>
              <Controls>
                <Control name="$(parent)_Pins"
                         layer="1">
                  <AnchorFill />
                </Control>
              </Controls>
            </Control>
            <StatusBar name="$(parent)_StatusOverlay"
                       layer="2"
                       color="ffffff"
                       alpha="0.8"
                       hidden="false">
              <AnchorFill />
              <Controls>
                <Label name="$(parent)_Label"
                       font="ZoFontAnnounceMedium"
                       layer="2"
                       text="Loading ...">
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER"
                          offsetY="0" />
                </Label>
              </Controls>
            </StatusBar>
          </Controls>
        </Scroll>
        <Label name="$(parent)_ZoomLabel"
               font="ZoFontGame"
               alpha="0.4"
               layer="4"
               tier="HIGH"
               hidden="true"
               text="0%">
          <Anchor point="TOPRIGHT"
                  relativeTo="$(parent)_Scroll"
                  relativePoint="TOPRIGHT"
                  offsetX="-4"
                  offsetY="4" />
        </Label>
        <Control name="$(parent)_FrameChromeHover"
                 mouseEnabled="true"
                 layer="4"
                 tier="HIGH">
          <Dimensions x="24"
                      y="24" />
          <OnMouseEnter>
            LUIE.MiniMap.OnFrameChromeHotspotMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnFrameChromeHotspotMouseExit(self)
          </OnMouseExit>
          <Controls>
            <Control name="$(parent)_FrameChrome"
                     hidden="true"
                     mouseEnabled="true">
              <Dimensions x="44"
                          y="20" />
              <OnMouseEnter>
                LUIE.MiniMap.OnFrameChromeMouseEnter(self)
              </OnMouseEnter>
              <OnMouseExit>
                LUIE.MiniMap.OnFrameChromeMouseExit(self)
              </OnMouseExit>
              <Controls>
                <Button name="$(parent)_PositionLock"
                        inherits="ZO_ButtonBehaviorClickSound"
                        mouseOverBlendMode="ADD"
                        mouseEnabled="true">
                  <Dimensions x="20"
                              y="20" />
                  <OnInitialized>
                    LUIE.MiniMap.OnFramePositionLockInitialized(self)
                  </OnInitialized>
                  <OnClicked>
                    LUIE.MiniMap.OnFramePositionLockClicked(self, button, ctrl, alt, shift, command)
                  </OnClicked>
                </Button>
                <Control name="$(parent)_MoveGrip"
                         inherits="ZO_MouseTooltipBehavior"
                         mouseEnabled="true">
                  <Dimensions x="20"
                              y="20" />
                  <OnInitialized>
                    LUIE.MiniMap.OnFrameMoveGripInitialized(self)
                  </OnInitialized>
                  <OnMouseDown>
                    LUIE.MiniMap.OnFrameMoveGripMouseDown(self, button, ctrl, alt, shift, command)
                  </OnMouseDown>
                  <OnMouseUp>
                    LUIE.MiniMap.OnFrameMoveGripMouseUp(self, button, upInside, ctrl, alt, shift, command)
                  </OnMouseUp>
                  <Controls>
                    <Texture name="$(parent)Icon"
                             resizeToFitFile="true"
                             textureFile="EsoUI/Art/Minimap/minimap_button_over.dds"
                             alpha="0.85">
                      <Anchor point="CENTER" />
                    </Texture>
                  </Controls>
                </Control>
              </Controls>
            </Control>
          </Controls>
        </Control>
        <Texture name="$(parent)_Player"
                 resizeToFitFile="true"
                 layer="2"
                 textureFile="EsoUI/Art/MapPins/UI-WorldMapPlayerPip.dds">
          <Anchor point="CENTER"
                  relativeTo="$(parent)_Scroll"
                  relativePoint="CENTER" />
        </Texture>
        <Texture name="$(parent)_PlayerCam"
                 resizeToFitFile="true"
                 layer="1"
                 textureFile="EsoUI/Art/MapPins/UI-WorldMapPlayerCameraPip.dds"
                 alpha="1">
          <Anchor point="CENTER"
                  relativeTo="$(parent)_Player"
                  relativePoint="CENTER" />
        </Texture>
        <Control name="$(parent)_ZoomChromeHover"
                 mouseEnabled="true"
                 layer="2"
                 tier="HIGH">
          <Dimensions x="32"
                      y="56" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)_Scroll"
                  relativePoint="BOTTOMRIGHT"
                  offsetX="-54"
                  offsetY="0" />
          <OnMouseEnter>
            LUIE.MiniMap.OnZoomChromeHoverMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnZoomChromeHoverMouseExit(self)
          </OnMouseExit>
        </Control>
        <Button name="$(parent)_ZoomIn"
                inherits="ZO_ButtonBehaviorClickSound"
                hidden="true"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                layer="4"
                tier="HIGH">
          <Dimensions x="24"
                      y="24" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)_Scroll"
                  relativePoint="BOTTOMRIGHT"
                  offsetX="-4"
                  offsetY="-4" />
          <Textures normal="EsoUI/Art/Minimap/minimap_zoomplus_up.dds"
                    pressed="EsoUI/Art/Minimap/minimap_zoomplus_down.dds"
                    disabled="EsoUI/Art/Minimap/minimap_zoomplus_disabled.dds"
                    mouseOver="EsoUI/Art/Minimap/minimap_zoom_mouseover.dds" />
          <OnClicked>
            LUIE.MiniMap.OnZoomInClicked(self, button, ctrl, alt, shift, command)
          </OnClicked>
          <OnMouseEnter>
            LUIE.MiniMap.OnZoomChromeHoverMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnZoomChromeHoverMouseExit(self)
          </OnMouseExit>
        </Button>
        <Button name="$(parent)_ZoomOut"
                inherits="ZO_ButtonBehaviorClickSound"
                hidden="true"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                layer="4"
                tier="HIGH">
          <Dimensions x="24"
                      y="24" />
          <Anchor point="BOTTOMRIGHT"
                  relativeTo="$(parent)_ZoomIn"
                  relativePoint="BOTTOMLEFT"
                  offsetX="-2"
                  offsetY="0" />
          <Textures normal="EsoUI/Art/Minimap/minimap_zoomminus_up.dds"
                    pressed="EsoUI/Art/Minimap/minimap_zoomminus_down.dds"
                    disabled="EsoUI/Art/Minimap/minimap_zoomminus_disabled.dds"
                    mouseOver="EsoUI/Art/Minimap/minimap_zoom_mouseover.dds" />
          <OnClicked>
            LUIE.MiniMap.OnZoomOutClicked(self, button, ctrl, alt, shift, command)
          </OnClicked>
          <OnMouseEnter>
            LUIE.MiniMap.OnZoomChromeHoverMouseEnter(self)
          </OnMouseEnter>
          <OnMouseExit>
            LUIE.MiniMap.OnZoomChromeHoverMouseExit(self)
          </OnMouseExit>
        </Button>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>