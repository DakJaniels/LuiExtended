<GuiXml>
    <!-- LUIE named fonts (keyboard). Declared with ZOS font-string macros so they
         reuse the engine fonts the base UI already loads - no addon CreateFont and no
         per-call ZO_CreateFontString composition. Names are unique from the gamepad,
         console, and gamecore fonts in fontdefs_gamepad.xml. -->

    <!-- Crowd Control Tracker (fixed, non-user-configurable sizes) -->
    <Font name="LUIE_Font_Keyboard_CrowdControlIcon" font="$(BOLD_FONT)|$(KB_25)|thick-outline"/>
    <Font name="LUIE_Font_Keyboard_CrowdControlCountdown" font="$(BOLD_FONT)|$(KB_28)|thick-outline"/>
    <Font name="LUIE_Font_Keyboard_CrowdControlStagger" font="$(BOLD_FONT)|$(KB_36)|thick-outline"/>
</GuiXml>
