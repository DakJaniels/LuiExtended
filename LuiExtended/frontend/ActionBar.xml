<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <Controls>
    <TopLevelControl name="LUIE_ACTIONBAR_CASTBAR_TLC"
                     mouseEnabled="false"
                     movable="false"
                     clampedToScreen="true"
                     hidden="true">
      <OnMoveStart>
        LUIE.ActionBar.CastBar.OnMoveStart(self)
      </OnMoveStart>
      <OnMoveStop>
        LUIE.ActionBar.CastBar.OnMoveStop(self)
      </OnMoveStop>
      <Controls>
        <Backdrop name="$(parent)_Preview"
                  hidden="true"
                  layer="BACKGROUND">
          <AnchorFill />
          <Edge edgeFileWidth="8"
                edgeFileHeight="1"
                edgeFilePadding="1" />
          <OnInitialized>
            self:SetCenterColor(0, 0, 0, 0.4)
            self:SetEdgeColor(0, 0, 0, 0.6)
          </OnInitialized>
          <Controls>
            <Label name="$(parent)_Label"
                   text="Cast Bar"
                   wrapMode="ELLIPSIS"
                   horizontalAlignment="CENTER"
                   verticalAlignment="CENTER">
              <Anchor point="CENTER"
                      relativeTo="$(parent)"
                      relativePoint="CENTER" />
            </Label>
            <Texture name="$(parent)_AnchorTexture"
                     textureFile="/esoui/art/reticle/border_topleft.dds"
                     color="FFFF00"
                     alpha="0.902"
                     layer="OVERLAY">
              <Dimensions x="16"
                          y="16" />
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT" />
            </Texture>
            <Backdrop name="$(parent)_AnchorLabelBg"
                      centerColor="000000"
                      edgeColor="000000"
                      layer="OVERLAY"
                      tier="LOW">
              <Edge edgeFileWidth="8"
                    edgeFileHeight="1"
                    edgeFilePadding="1" />
            </Backdrop>
            <Label name="$(parent)_AnchorLabel"
                   font="ZoFontGamepad22"
                   color="FFFF00"
                   text="xxx, yyy"
                   wrapMode="ELLIPSIS"
                   horizontalAlignment="LEFT"
                   verticalAlignment="TOP"
                   layer="OVERLAY"
                   tier="MEDIUM">
              <Anchor point="BOTTOMLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="0"
                      offsetY="-1" />
            </Label>
          </Controls>
        </Backdrop>
        <Backdrop name="$(parent)_Icon"
                  layer="BACKGROUND">
          <Anchor point="LEFT"
                  relativeTo="$(parent)"
                  relativePoint="LEFT" />
          <Edge edgeFileWidth="8"
                edgeFileHeight="1"
                edgeFilePadding="1" />
          <OnInitialized>
            self:SetCenterColor(0, 0, 0, 0.5)
            self:SetEdgeColor(0, 0, 0, 1)
            self:SetHidden(true)
          </OnInitialized>
          <Controls>
            <Texture name="$(parent)_Back"
                     layer="OVERLAY"
                     tier="MEDIUM">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT" />
            </Texture>
            <Texture name="$(parent)_IconBg"
                     layer="BACKGROUND"
                     level="1">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT" />
            </Texture>
            <Texture name="$(parent)_Icon"
                     textureFile="/esoui/art/icons/icon_missing.dds"
                     layer="CONTROLS">
              <Anchor point="TOPLEFT"
                      relativeTo="$(parent)"
                      relativePoint="TOPLEFT"
                      offsetX="2"
                      offsetY="2" />
              <Anchor point="BOTTOMRIGHT"
                      relativeTo="$(parent)"
                      relativePoint="BOTTOMRIGHT"
                      offsetX="-2"
                      offsetY="-2" />
            </Texture>
            <Backdrop name="$(parent)_BarBackdrop"
                      layer="BACKGROUND">
              <Anchor point="LEFT"
                      relativeTo="$(parent)"
                      relativePoint="RIGHT"
                      offsetX="4"
                      offsetY="0" />
              <Edge edgeFileWidth="8"
                    edgeFileHeight="2"
                    edgeFilePadding="2" />
              <OnInitialized>
                self:SetCenterColor(0, 0, 0, 0.4)
                self:SetEdgeColor(0, 0, 0, 0.6)
              </OnInitialized>
              <Controls>
                <StatusBar name="$(parent)_Bar">
                  <Anchor point="CENTER"
                          relativeTo="$(parent)"
                          relativePoint="CENTER" />
                </StatusBar>
                <Label name="$(parent)_Name"
                       text="Name"
                       hidden="true"
                       wrapMode="ELLIPSIS"
                       horizontalAlignment="CENTER"
                       verticalAlignment="CENTER">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)"
                          relativePoint="LEFT"
                          offsetX="4"
                          offsetY="0" />
                </Label>
                <Label name="$(parent)_Timer"
                       text="Timer"
                       hidden="true"
                       wrapMode="ELLIPSIS"
                       horizontalAlignment="CENTER"
                       verticalAlignment="CENTER">
                  <Anchor point="RIGHT"
                          relativeTo="$(parent)"
                          relativePoint="RIGHT"
                          offsetX="-4"
                          offsetY="0" />
                </Label>
                <Texture name="$(parent)_LineLA"
                         color="FFFFFF"
                         hidden="true" />
                <Texture name="$(parent)_LineSkill"
                         color="FFFFFF"
                         hidden="true" />
                <Texture name="$(parent)_LineDelay"
                         color="FFFFFF"
                         hidden="true" />
              </Controls>
            </Backdrop>
          </Controls>
        </Backdrop>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
