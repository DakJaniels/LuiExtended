	<Controls>
		<!-- Virtual template for buff icon controls used by ZO_ControlPool -->
		<!-- Root is a Control - backdrop is added as a child that fills it -->
		<Control name="LUIE_SpellCastBuffIcon"
		         virtual="true"
		         mouseEnabled="true"
		         space="SPACE_INTERFACE">
			<OnMouseEnter>
				LUIE_SpellCastBuffIcon_OnMouseEnter(self)
			</OnMouseEnter>
			<OnMouseExit>
				LUIE_SpellCastBuffIcon_OnMouseExit(self)
			</OnMouseExit>
			<OnMouseUp>
				LUIE_SpellCastBuffIcon_OnMouseUp(self, button, upInside, ctrl, alt, shift, command)
			</OnMouseUp>
			<Controls>
				<!-- Main backdrop (fills the control, acts as background) -->
				<Backdrop name="$(parent)Backdrop"
				          centerColor="00000080"
				          edgeColor="000000FF"
				          layer="BACKGROUND"
				          pixelRoundingEnabled="false"
				          space="SPACE_INTERFACE">
					<AnchorFill/>
					<Edge file=""
					      edgeFileWidth="32"
					      edgeFileHeight="8"/>
					<Center file=""/>
					<Insets left="8"
					        top="8"
					        right="-8"
					        bottom="-8"/>
					<AnchorFill/>
				</Backdrop>
				<!-- Border layer (back) - hidden by default, shown only for non-collectible buffs -->
				<Texture name="$(parent)Back"
				         textureFile="LuiMedia/media/icons/abilities/ability_innate_background.dds"
				         layer="BACKGROUND"
				         hidden="true"
				         space="SPACE_INTERFACE">
					<AnchorFill/>
				</Texture>
				<!-- Glow border layer (frame) -->
				<Texture name="$(parent)Frame"
				         layer="OVERLAY"
				         hidden="false"
				         space="SPACE_INTERFACE">
					<Anchor point="CENTER"
					        relativePoint="CENTER"/>
				</Texture>
				<!-- Background layer (iconbg) - conditional, not for player_long -->
				<Texture name="$(parent)IconBG"
				         textureFile="LuiMedia/media/icons/abilities/ability_innate_background.dds"
				         layer="CONTROLS"
				         hidden="false"
				         space="SPACE_INTERFACE">
					<AnchorFill/>
					<Controls>
						<!-- Dark backdrop behind the texture -->
						<Backdrop name="$(parent)IconBGBackdrop"
						          centerColor="000000E6"
						          edgeColor="000000E6"
						          layer="CONTROLS"
						          level="CONTROLS"
						          pixelRoundingEnabled="false"
						          space="SPACE_INTERFACE">
							<AnchorFill/>
							<Edge file="EsoUI/Art/Miscellaneous/Gamepad/gp_frameEdge_8px.dds"
							      edgeFileWidth="64"
							      edgeFileHeight="8"/>
							<Center file="EsoUI/Art/Miscellaneous/Gamepad/gp_edgeFill.dds"/>
							<Insets left="8"
							        top="8"
							        right="-8"
							        bottom="-8"/>
							<AnchorFill/>
						</Backdrop>
						<!-- Main ability icon (child of IconBG) -->
						<Texture name="$(parent)Icon"
						         textureFile="/esoui/art/icons/icon_missing.dds"
						         layer="CONTROLS"
						         hidden="false"
						         space="SPACE_INTERFACE">
							<!-- Anchors set dynamically in Lua -->
						</Texture>
					</Controls>
				</Texture>
				<!-- Cooldown control (radial timer, renders under icon on BACKGROUND layer) -->
				<Cooldown name="$(parent)Cooldown"
				          inherits="ZO_DefaultCooldown"
				          layer="BACKGROUND"
				          hidden="false"
				          space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua: TOPLEFT with 1,1 and BOTTOMRIGHT with -1,-1 -->
				</Cooldown>
				<!-- Collectible/mount background (drop) - hidden by default -->
				<Texture name="$(parent)Drop"
				         textureFile="LuiMedia/media/icons/abilities/ability_innate_background.dds"
				         layer="BACKGROUND"
				         hidden="true"
				         space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua -->
				</Texture>
				<!-- Duration label -->
				<Label name="$(parent)Label"
				       font="ZoFontGame"
                       horizontalAlignment="CENTER"
				       hidden="false"
				       space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua: TOPLEFT to LEFT with padding, BOTTOMRIGHT to BOTTOMRIGHT -->
				</Label>
				<!-- Debug ability ID label -->
				<Label name="$(parent)AbilityId"
				       font="ZoFontGame"
				       layer="OVERLAY"
				       tier="DT_MEDIUM"
				       hidden="false"
				       space="SPACE_INTERFACE">
					<Anchor point="CENTER"
					        relativePoint="CENTER"/>
				</Label>
				<!-- Stack count label -->
				<Label name="$(parent)Stack"
				       font="ZoFontGame"
				       hidden="false"
				       space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua: CENTER to BOTTOMLEFT and CENTER to TOPRIGHT -->
				</Label>
				<!-- Prominent buff name label (hidden by default, shown only for prominent containers) -->
				<Label name="$(parent)Name"
				       font="ZoFontGame"
				       hidden="true"
				       space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua -->
				</Label>
				<!-- Prominent buff progress bar backdrop -->
				<Backdrop name="$(parent)BarBackdrop"
				          centerColor="00000000"
				          edgeColor="00000000"
				          layer="BACKGROUND"
				          level="CONTROLS"
				          hidden="true"
				          pixelRoundingEnabled="false"
				          space="SPACE_INTERFACE">
					<!-- Dimensions: 154x16, anchors set dynamically in Lua -->
				</Backdrop>
				<!-- Prominent buff progress bar -->
				<StatusBar name="$(parent)Bar"
				           hidden="true"
				           space="SPACE_INTERFACE">
					<!-- Dimensions: 150x12, anchors set dynamically in Lua -->
				</StatusBar>
			</Controls>
		</Control>
	</Controls>
</GuiXml>
