				<!-- Preview texture for position preview -->
				<Texture name="$(parent)Preview"
				         textureFile="/esoui/art/miscellaneous/inset_bg.dds"
				         layer="BACKGROUND"
				         hidden="true"
				         space="SPACE_INTERFACE">
					<AnchorFill/>
					<Controls>
						<!-- Preview label -->
						<Label name="$(parent)PreviewLabel"
						       font="ZoFontGameMedium"
						       horizontalAlignment="CENTER"
						       verticalAlignment="CENTER"
						       space="SPACE_INTERFACE">
							<Anchor point="CENTER"
							        relativePoint="CENTER"/>
						</Label>
						<!-- Anchor texture for coordinate display -->
						<Texture name="$(parent)AnchorTexture"
						         textureFile="/esoui/art/reticle/border_topleft.dds"
						         layer="OVERLAY"
						         hidden="false"
						         space="SPACE_INTERFACE">
							<Anchor point="TOPLEFT"
							        relativePoint="TOPLEFT"/>
							<Dimensions x="16"
							            y="16"/>
						</Texture>
						<!-- Anchor label for coordinate display -->
						<Label name="$(parent)AnchorLabel"
						       font="ZoFontGameSmall"
						       text="xxx, yyy"
						       layer="OVERLAY"
						       tier="DT_MEDIUM"
						       hidden="false"
						       space="SPACE_INTERFACE">
							<Anchor point="BOTTOMLEFT"
							        relativePoint="TOPLEFT"
							        offsetX="0"
							        offsetY="-1"/>
							<Dimensions x="0"
							            y="2"/>
						</Label>
						<!-- Anchor label background -->
						<Backdrop name="$(parent)AnchorLabelBg"
						          centerColor="000000FF"
						          edgeColor="000000FF"
						          layer="OVERLAY"
						          tier="DT_LOW"
						          hidden="false"
						          pixelRoundingEnabled="false"
