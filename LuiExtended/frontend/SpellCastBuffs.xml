	<Controls>
		<!-- Virtual template for buff icon controls used by ZO_ControlPool -->
		<!-- Root is a Backdrop (acts as main background with border) -->
		<!-- Control creation order matches original 6.3.2 for proper rendering -->
		<!-- Original: UI.Backdrop sets SetEdgeTexture("", 8, 1, 0) -->
		<!-- No Edge element needed - dimensions set in Lua via SetDimensions -->
		<Backdrop name="LUIE_SpellCastBuffIcon" virtual="true" mouseEnabled="true" centerColor="00000080" edgeColor="000000FF" space="SPACE_INTERFACE">
			<OnMouseEnter>
				LUIE_SpellCastBuffIcon_OnMouseEnter(self)
			</OnMouseEnter>
			<OnMouseExit>
				LUIE_SpellCastBuffIcon_OnMouseExit(self)
			</OnMouseExit>
			<OnMouseUp>
				LUIE_SpellCastBuffIcon_OnMouseUp(self, button, upInside, ctrl, alt, shift, command)
			</OnMouseUp>
			<Controls>
				<!-- Border layer (back) - defaults to CONTROLS layer in original -->
				<Texture name="$(parent)Back" textureFile="/esoui/art/actionbar/abilityframe64_up.dds" hidden="true" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua -->
				</Texture>
				<!-- Glow border layer (frame) - defaults to CONTROLS layer in original -->
				<Texture name="$(parent)Frame" hidden="false" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua -->
				</Texture>
				<!-- Background layer (iconbg) - Backdrop with level=1, not created for player_long -->
				<!-- Original: UI.Backdrop defaulting to BACKGROUND layer, then SetDrawLevel(DL_CONTROLS=1) -->
				<!-- Original edge: SetEdgeTexture("", 8, 1, 0) - but empty texture, so no Edge needed -->
				<Backdrop name="$(parent)IconBG" centerColor="000000E6" edgeColor="000000E6" layer="BACKGROUND" level="1" hidden="false" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua with inset -->
				</Backdrop>
				<!-- Collectible/mount background (drop) - created before icon in original -->
				<Texture name="$(parent)Drop" textureFile="LuiMedia/media/icons/abilities/ability_innate_background.dds" layer="BACKGROUND" hidden="true" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua with inset -->
				</Texture>
				<!-- Main ability icon - CONTROLS layer -->
				<Texture name="$(parent)Icon" textureFile="/esoui/art/icons/icon_missing.dds" layer="CONTROLS" hidden="false" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua with inset -->
				</Texture>
				<!-- Duration label -->
				<Label name="$(parent)Label" font="ZoFontGame" horizontalAlignment="CENTER" verticalAlignment="CENTER" wrapMode="TEXT_WRAP_MODE_ELLIPSIS" hidden="false" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua -->
				</Label>
				<!-- Debug ability ID label -->
				<Label name="$(parent)AbilityId" font="ZoFontGame" horizontalAlignment="CENTER" verticalAlignment="CENTER" wrapMode="TEXT_WRAP_MODE_ELLIPSIS" hidden="false" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua -->
				</Label>
				<!-- Stack count label -->
				<Label name="$(parent)Stack" font="ZoFontGame" horizontalAlignment="CENTER" verticalAlignment="CENTER" wrapMode="TEXT_WRAP_MODE_ELLIPSIS" hidden="false" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua -->
				</Label>
				<!-- Cooldown control (radial timer) - created AFTER labels in original, BACKGROUND layer -->
				<Cooldown name="$(parent)Cooldown" layer="BACKGROUND" hidden="false" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua -->
				</Cooldown>
				<!-- Prominent buff name label (hidden by default, shown only for prominent containers) -->
				<Label name="$(parent)Name" font="ZoFontGame" wrapMode="TEXT_WRAP_MODE_ELLIPSIS" verticalAlignment="CENTER" hidden="true" space="SPACE_INTERFACE">
					<!-- Anchors set dynamically in Lua based on direction settings -->
				</Label>
				<!-- Prominent buff progress bar backdrop -->
				<!-- Original: SetEdgeTexture("",8,2,2) - but empty texture with asymmetric dimensions may cause stretching -->
				<Backdrop name="$(parent)BarBackdrop" centerColor="00000000" edgeColor="00000000" layer="BACKDROP" level="1" hidden="true" space="SPACE_INTERFACE">
					<!-- Anchors and dimensions set dynamically in Lua -->
					<Edge file="" edgeFileWidth="2" edgeFileHeight="2" edgeFilePadding="2"/>
				</Backdrop>
				<!-- Prominent buff progress bar -->
				<StatusBar name="$(parent)Bar" hidden="true" space="SPACE_INTERFACE">
					<!-- Anchors and dimensions set dynamically in Lua -->
				</StatusBar>
			</Controls>
		</Backdrop>
	</Controls>
</GuiXml>
