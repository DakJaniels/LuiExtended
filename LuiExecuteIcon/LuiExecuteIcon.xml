<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <Controls>
    <TopLevelControl name="LuiExecuteIconWindow"
                     mouseEnabled="false"
                     hidden="true">
      <Dimensions x="64"
                  y="64" />
      <Anchor point="TOPLEFT"
              relativeTo="GuiRoot"
              relativePoint="TOPLEFT"
              offsetX="0"
              offsetY="0" />
      <!-- Re-anchored in Lua (OnDeferredInitialize) to ZO_TargetUnitFramereticleover -->
      <Controls>
        <Texture name="$(parent)_Skull"
                 textureFile="LuiExecuteIcon/unitframes_execute.dds"
                 hidden="true">
          <Dimensions x="64"
                      y="64" />
          <Anchor point="CENTER"
                  relativeTo="$(parent)"
                  relativePoint="CENTER"
                  offsetX="0"
                  offsetY="0" />
        </Texture>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>